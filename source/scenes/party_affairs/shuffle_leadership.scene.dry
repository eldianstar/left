- #pragmatist_advisor

@add_wagenknecht
title: Sahra Wagenknecht
subtitle: Sahra Wagenknecht is [? if oldleft_leader == "Wagenknecht" : the Eastern leader of our traditional left wing. ?][? if oldleft_leader != "Wagenknecht" : a prominent Eastern figure in our traditional left wing. ?] {!<br><br>!}[? if difficulty < 0 : Actions - text ?]
is-card: true
card-image: img/_portraits/WagenknechtSahra.jpg
tags: oldleft_advisor
view-if: wagenknecht_left == 0
on-arrival: wagenknecht_advisor = 1; n_advisors += 1; n_advisors_woman += 1; oldleft_dissent -= 2*(wagenknecht_advisor_fame/100);
go-to: beweli_advisor_choice if in_left_leadership = 1; emali_advisor_choice if in_hufeisen_leadership = 1;

