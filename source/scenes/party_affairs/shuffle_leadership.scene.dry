####################### adding advisors

@add_advisors
title: Add advisors
choose-if: n_advisors < 3
unavailable-subtitle: Maximum of 3 advisors.
go-to: advisor_menu

@advisor_menu
title: Add other advisors.
tags: center_advisor, left_advisor, reformist_advisor, labor_advisor, neorev_advisor, nonfactional_advisor
frequency: 1


- @oldleft_advisor_choice: Add Old Leftists
- @beweli_advisor_choice: Add Movement Leftists
- @emali_advisor_choice: Add Centrists
- @pragmatist_advisor_choice: Add Pragmatists
- @rm_main: Remove advisors instead.
- @remove_none: Stop changing advisors.

@oldleft_advisor_choice
view-if: n_advisor < 3

- #oldleft_advisor

@beweli_advisor_choice
view-if: n_advisor < 3

- #beweli_advisor

@emali_advisor_choice
