title: Important Issues
new-page: true
is-card: true
tags: party_affairs
view-if: issues_timer <= 0
on-arrival: month_actions += 1; issues_timer = 6
card-image: img/protest.jpg

text
  
- @cost_of_living: cost of living
- @welfare: better welfare
- @services: expand services
- @feminism: feminism and lgbtq
- @pacifism: Opposing war, nationalism, and militarism at all costs.
- @environmentalism: environment
- @antifascism: antifascism
- @promigration: promigration
- @antimigration: Antimigration
- @easy_discard

@cost_of_living
  on-arrival: issue_cost_of_living += 1; issue_welfare -= 0.2; issue_feminism -= 0.2; issue_services -= 0.2; issue_pacifism -= 0.2; econ_moderation -= 0.5; urban_linke += 1*(1-dissent); upper_linke -= 0.5;

@welfare
  on-arrival: issue_cost_of_living -= 0.2; issue_welfare += 1; issue_feminism -= 0.2; issue_services -= 0.2; issue_pacifism -= 0.2; econ_moderation -= 0.5; urban_linke += 1*(1-dissent); rural_linke += 0.5*(1-dissent); youth_linke -= 0.5; upper_linke -= 0.5;

@services
  on-arrival: issue_cost_of_living -= 0.2; issue_welfare -= 0.2; issue_feminism -= 0.2; issue_services += 1; issue_pacifism -= 0.2; econ_moderation -= 0.5; urban_linke += 1*(1-dissent); youth_linke += 1*(1-dissent); rural_linke -= 0.5; greens_relation += 1;

@feminism
view-if: oldleft_strength < 45
on-arrival: issue_cost_of_living -= 0.2; issue_welfare -= 0.2; issue_feminism += 1; issue_services -= 0.2; issue_pacifism -= 0.2; social_moderation -= 0.5; youth_linke += 0.5*(1-dissent); oldleft_dissent += 5; beweli_strength += 1; greens_relation += 1;

@pacifism
view-if: pragmatist_strength < 65
on-arrival: issue_cost_of_living -= 0.2; issue_welfare -= 0.2; issue_feminism -= 0.2; issue_services -= 0.2; issue_pacifism += 1; foreign_moderation -= 0.5; youth_linke += 0.5*(1-dissent); pragmatist_dissent += 2;

@environmentalism
view-if: oldleft_strength < 40
on-arrival: issue_environmentalism += 1; youth_linke += 1*(1-dissent); youth_greens -= 1*(1-dissent); greens_relation += 2;

@antifascism
view-if: afd_votes >= 20
on-arrival: issue_antifascism += 1; econ_moderation += 0.5; youth_linke += (afd_votes/15)*(1-dissent); pro_status_quo -= 1; greens_relation += 2; spd_relation += 2;

@promigration
view-if: oldleft_strength < 45
on-arrival: issue_migration -= 1; pro_status_quo += 1; social_moderation -= 0.5; youth_linke += 1*(1-dissent); oldleft_dissent += 1;

@antimigration
view-if: oldleft_strength >= 45
on-arrival: issue_migration += 1; pro_status_quo -= 2; social_moderation += 1; oldleft_dissent -= 3; youth_linke -= 2; urban_linke -= 1; rural_linke += 2*(1-dissent); bsw_relation += 5;
