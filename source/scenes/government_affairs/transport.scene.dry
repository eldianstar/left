title: Transport
new-page: true
is-card: true
tags: govt_affairs, cabinet
on-arrival: transport_timer += 6; month_actions += 1
view-if: linke_in_government = 1 and transport_minister_party = "LINKE" and transport_timer <= 0
card-image: img/portraits/SeveringCarl.jpg

= transport

text

- @bikelanes: bike lanes
- @db_railway: db railway
- @modernize_internet: modernize internet

@bikelanes
view-if: social_moderation < 10
on-arrival: youth_linke += ((issue_environment-1)/1.5)*(1-dissent); urban_linke += ((issue_environment-1)/3)*(1-dissent); issue_environment -= 0.5; greens_relation += 4*(1-dissent); greens_coalition_dissent -= 0.2*(1-dissent); bike_lanes += 1;

@db_railway
choose-if: budget >= 1
subtitle: -1 budget
on-arrival: db_rail += 1; budget -= 1; urban_linke += 2/db_rail*(1-dissent); youth_linke += 2*(1-dissent); east_linke += 1*(1-dissent); economic_growth += 0.7; urban_qol += 1; rural_qol += 1; youth_qol += 1;

@modernize_internet
choose-if: budget >= 1
subtitle: -1 budget
on-arrival: modern_internet += 1; budget -= 1; economic_growth += 0.4; youth_qol += 1; upper_linke += (1-dissent); youth_linke += (1-dissent);
  
