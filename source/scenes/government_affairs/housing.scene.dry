title: Housing and Urban Development Affairs
new-page: true
is-card: true
tags: govt_affairs, cabinet
on-arrival: housing_timer += 6; month_actions += 1
view-if: linke_in_government = 1 and housing_minister_party = "LINKE" and housing_timer <= 0
card-image: img/portraits/SeveringCarl.jpg

= housing/urbdev affairs

text

- @rentfreeze: freeze rents
- @circumvention: circumvention
- @modernization: modernization
- @rentreduction: rentreduction
- @build_housing: build housing
- @socializeover3k: socialize over 3k
- @noaction: Take no action for now.
- @easy_discard
- @cancel_advisor_action

@rentfreeze
view-if: frozen_rents == 0
choose-if: econ_moderation < 8
unavailable-subtitle: econ moderation
on-arrival: frozen_rents = 1; urban_linke += issue_cost_of_living*(1-dissent); youth_linke += (issue_cost_of_living*(1-dissent))/2; east_linke += (issue_cost_of_living*(1-dissent))/3; pro_status_quo += 1; issue_cost_of_living -= 1; upper_linke -= 2; spd_relation -= 1;

@circumvention
view-if: frozen_rents == 1 and rent_circumvention == 0
choose-if: econ_moderation < 7
unavailable_subtitle: econ moderation
on-arrival: rent_circumvention = 1; urban_linke += (issue_cost_of_living*(1-dissent))/2; issue_cost_of_living -= 0.5; pro_status_quo += 1; upper_linke -= 1;

@modernization
view-if: frozen_rents == 1 and rent_modernization == 0
choose-if: econ_moderation < 7
unavailable_subtitle: econ moderation
on-arrival: rent_modernization = 1; urban_linke += (issue_cost_of_living*(1-dissent))/2; issue_cost_of_living -= 0.5; pro_status_quo += 1; upper_linke -= 1;

@rentreduction
view-if: rent_modernization == 1 and rent_reduction == 0
choose-if: econ_moderation < 7
unavailable_subtitle: econ moderation
on-arrival: rent_reduction = 1; urban_linke += (issue_cost_of_living*(1-dissent))/2; issue_cost_of_living -= 0.5; pro_status_quo += 1; upper_linke -= 1;

@build_housing
choose-if: budget >= 1
unavailable_subtitle: budget
on-arrival: budget -= 1; urban_linke += (issue_cost_of_living*(1-dissent)); issue_cost_of_living -= 1; upper_linke -= 1; pro_status_quo += 1; housing_built += 1;

@socializeover3k
view-if: nationalized_housing < 3
choose-if: budget >= 2 and econ_moderation < 6
unavailable_subtitle: budget/econ moderation
on-arrival: budget -= 2; urban_linke += (issue_cost_of_living*(1-dissent))*1.5; issue_cost_of_living -= 1.5; upper_linke -= 2; pro_status_quo += 1; greens_relation -= 2; spd_relation -= 2; pragmatist_dissent += 2; nationalized_housing += 1;

@noaction
on-arrival: urban_linke -= issue_cost_of_living; econ_moderation += 0.5; oldleft_dissent += 1; beweli_dissent += 1; emali_dissent += 1;
