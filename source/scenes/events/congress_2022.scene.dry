title: 2022 Erfurt Conference
subtitle: The Left holds its 8th Party Congress in Erfurt
new-page: true
tags: event
view-if: year == 2021 and month >= 6
set-jump: post_congress
max-visits: 1

# the low priority means that this event is only seen after all other events are resolved for the month.
# note: z_coalition = z_celation + (pro_cepublic/2); z_coalition *= 1.25 if z_faction_leader == "Joos";

= 2022 Erfurt Congress

Die Linke is holding its annual congress in Erfurt, where the party is expected to formulate a definitive stance on the war in Ukraine.

- @faction_algorithm: The delegates enter...

@faction_algorithm
on-arrival: {!

Q.oldleft_votes = 0;
Q.beweli_votes = 0;
Q.pragmatist_votes = 0;
Q.emali_votes = 0;

Q.oldleft_urban = 1;
Q.oldleft_rural = 1;
Q.oldleft_youth = 1;
Q.oldleft_upper = 1;
Q.oldleft_east = 1;

Q.beweli_urban = 1;
Q.beweli_rural = 1;
Q.beweli_youth = 1;
Q.beweli_upper = 1;
Q.beweli_east = 1;

Q.emali_urban = 1;
Q.emali_rural = 1;
Q.emali_youth = 1;
Q.emali_upper = 1;
Q.emali_east = 1;

Q.pragmatist_urban = 1;
Q.pragmatist_rural = 1;
Q.pragmatist_youth = 1;
Q.pragmatist_upper = 1;
Q.pragmatist_east = 1;

var total_linke = 0;
var total_factions = 0;

// Calculate performance
var linke_performance = Q.linke_votes - Q.old_linke_performance;
if (Q.old_linke_performance) {
    Q.old_linke_performance = Q.linke_votes;
} else {
    Q.old_linke_performance = 26;
}
if (!linke_performance) {
    linke_performance = Q.linke_votes - Q.old_linke_performance;
}

console.log("linke performance delta:", linke_performance);

// Sum linke-normalized votes across all classes
for (var c of Q.classes) {
    total_linke += (Q[c + '_linke_normalized'] * Q[c]);
}
console.log("Total Linke weighted class vote:", total_linke);

// Loop through factions and classes
for (var faction of Q.factions) {
    Q[faction + '_votes'] = 0; // Ensure clean start

    for (var c of Q.classes) {
        var base_vote = ((Q[faction + '_strength'] / 100) * Q[faction + '_' + c]) * ((Q[c + '_linke_normalized'] * Q[c]) / total_linke);
        var dissent = Q[faction + '_dissent'] || 0;
        var dissent_modifier = 1 + (dissent / 60) * (-linke_performance / 10) * 5;

        console.log(`[${faction}] + [${c}]`);
        console.log("  Base vote:", base_vote.toFixed(4));
        console.log("  Dissent:", dissent);
        console.log("  Dissent modifier:", dissent_modifier.toFixed(4));

        if (dissent_modifier < 0.1) {
            dissent_modifier = 0.1;
        }

        Q[faction + '_votes'] += base_vote * dissent_modifier;
    }

    console.log(`[${faction}] total votes before normalization:`, Q[faction + '_votes'].toFixed(2));

    total_factions += Q[faction + '_votes'];
}

// Normalize to percentage
for (var faction of Q.factions) {
    Q[faction + '_votes'] = Math.round((Q[faction + '_votes'] / total_factions) * 100);
    console.log(`[${faction}] normalized vote %:`, Q[faction + '_votes']);
}
!}
go-to: post_congress

@post_congress
on-arrival: {!
// set old results
// election threshold constitutional reform
// banning parties
var new_faction_sum = 0;
for (var faction of Q.factions) {
    Q['old_' + faction + '_c'] = Q[faction + '_c'];
    Q[faction + '_c'] = Q[faction + '_votes'];
        // if we use decimals, then we might want to truncate the numbers
    if (Q.use_decimals) {
        Q[faction + '_c_disp'] = Q[faction+'_c'].toFixed(1);
    }  else {
            Q[faction + '_c_disp'] = Q[faction+'_c'];
    }
    Q['change_' + faction + '_c'] = Q[faction + '_c'] - Q['old_' + faction + '_c'];
    var sign = Q['change_' + faction + '_c'] > 0 ? '+'  : '';
    Q['str_change_' + faction] = sign + Q['change_' + faction + '_c'];//.toFixed(1);
}
// calculate new faction sum if electoral reform
if (Q.electoral_threshold && Q.electoral_threshold > 0 || Q.faction_bans) {
    for (var faction of Q.parties) {
        if (Q[faction + '_c'] > 0) {
            if (Q.use_decimals) {
                Q[faction + '_c'] = Math.round(Q[faction + '_c']*1000/new_faction_sum)/10;
            } else {
                Q[faction + '_c'] = Math.round(Q[faction + '_c']*100/new_faction_sum);
            }
        }
        if (Q.use_decimals) {
            Q[faction + '_c_disp'] = Q[faction+'_c'].toFixed(1);
        } else {
            Q[faction + '_c_disp'] = Q[faction+'_c'];
        }
        Q['change_' + faction + '_c'] = Q[faction + '_c'] - Q['old_' + faction + '_c'];
        var sign = Q['change_' + faction + '_c'] > 0 ? '+'  : '';
        Q['str_change_' + faction] = sign + Q['change_' + faction + '_c'];//.toFixed(1);
    }
}

Q.left_leadership = Q.oldleft_c+Q.beweli_c;
Q.progressive_leadership = Q.beweli_c+Q.emali_c;
Q.right_leadership = Q.emali_c+Q.pragmatist_c;
Q.hufeisen_leadership = Q.oldleft_c+Q.emali_c;
!}
on-display: {!
if (!Q.neorevisionism) {
    data = [
        {   "id": "oldleft",
            "legend": "Old Left",
            "name": "Old Left",
            "seats": Math.round(Q.oldleft_c*4.15),
        },
        {
            "id": "beweli",
            "legend": "Movement Left",
            "name": "Movement Left",
            "seats": Math.round(Q.beweli_c*4.15),
        },
        {
            "id": "emali",
            "legend": "Center",
            "name": "Center",
            "seats": Math.round(Q.emali_c*4.15),
        },
        {
            "id": "pragmatist",
            "legend": "Pragmatists",
            "name": "Pragmatists",
            "seats": Math.round(Q.pragmatist_c*4.15),
        },
];
}

if (window && d3) {
    var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

{!<svg id="reichstag" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td></tr>!}

{!<tr><td><div class="box" style='background-color:#4C0B5F'> </div> !} Old Left: {!</td><td>!} [+ oldleft_c +]% {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#BC2D72'> </div> !} Movement Left: {!</td><td>!} [+ beweli_c +]% {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ff681d'> </div> !} Center: {!</td><td>!} [+ emali_c +]% {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ff5500'> </div> !} Pragmatists: {!</td><td>!} [+ pragmatist_c +]% {!</td></tr>!}

@coalition_menu

The prominent issue in the conference is clearly the war in Ukraine and our stance towards both Russia and Western aid to Ukraine.

- @oppositionist: The party remarks its support for the Ukrainian people against Russian aggression.
- @avoid_decision: Defer making a decision.
- @participationist: The party declares absolute neutrality.

@oppositionist
choose-if: right_leadership >= 50 or foreign_moderation >= 5 or oldleft_c < 25
subtitle: Russian imperialism is clearly at fault for the war. We must stand with Ukraine in these dark times.
on-arrival: foreign_moderation += 2; pragmatist_strength += 2; oldleft_strength -= 2; oldleft_dissent += 30; greens_relation += 3; spd_relation += 1; cdu_relation += 1;
go-to: leadership_election

We have remarked our support for Ukraine. While our right wing cheers this outcome and the moderate parties are pleased by our decision, the Old Left sees this as a betrayal and feels increasingly sidelined. Some people talk about a party split. 

@avoid_decision
subtitle: We must avoid taking a definitive side.
choose-if: right_leadership < 40 and oldleft_c >= 20 and oldleft_c < 45 and foreign_moderation < 7 and foreign_moderation >= 3
on-arrival: oldleft_dissent += 5; pragmatist_dissent += 5; emali_dissent += 5;
go-to: leadership_election

@participationist
choose-if: oldleft_c >= 45 or (oldleft_c >= 35 and foreign_moderation < 2)
subtitle: After all, we mustn't forget that Russia was initially provoked by NATO imperialism.
on-arrival: oldleft_strength += 5; oldleft_dissent -= 5; pragmatist_dissent += 30; emali_dissent += 15; greens_relation -= 5; spd_relation -= 2; cdu_relation -= 2; foreign_moderation -= 2;
go-to: leadership_election

Unexpectedly, the delegates have decided to maintain a neutral stance between Ukraine and Russia. While our left wing cheers, the moderate parties and our right wing are greatly disappointed by the party's decision.

@leadership_election
title: Now, let us choose the Party Leadership.

- @left_leadership: The left wing of the party takes power.
- @progressive_leadership: The new leadership will represent the progressive centrist wings of the party.
- @right_leadership: The right wing of the party takes power.
- @hufeisen_leadership: The left and right wings have settled on a horshoe power sharing agreement.
- @vote_stalled: The vote reaches a deadlock

@left_leadership
choose-if: left_leadership >= 50 and (issue_feminism < 5 or oldleft_leader != "Wagenknecht")
on-arrival: in_left_leadership = 1; beweli_dissent -= 5; oldleft_dissent -= 5; hennigwellsow_advisor = 0; wissler_advisor = 0; wagenknecht_advisor = 0; mohamedali_advisor = 0; riexinger_advisor = 0; pellmann_advisor = 0; gohlke_advisor = 0; schwerdtner_advisor = 0; pantisano_advisor = 0; buenger_advisor = 0; lay_advisor = 0; kipping_advisor = 0; reichinnek_advisor = 0; vanaken_advisor = 0; schirdewan_advisor = 0; hoss_advisor = 0; gysi_advisor = 0; bartsch_advisor = 0; ramelow_advisor = 0; goerke_advisor = 0; n_advisors = 0; n_advisors_woman = 0;
go-to: oldleft_advisor_choice

@progressive_leadership
choose-if: progressive_leadership >= 50
on-arrival: in_progressive_leadership = 1; beweli_dissent -= 5; emali_dissent -= 5; hennigwellsow_advisor = 0; wissler_advisor = 0; wagenknecht_advisor = 0; mohamedali_advisor = 0; riexinger_advisor = 0; pellmann_advisor = 0; gohlke_advisor = 0; schwerdtner_advisor = 0; pantisano_advisor = 0; buenger_advisor = 0; lay_advisor = 0; kipping_advisor = 0; reichinnek_advisor = 0; vanaken_advisor = 0; schirdewan_advisor = 0; hoss_advisor = 0; gysi_advisor = 0; bartsch_advisor = 0; ramelow_advisor = 0; goerke_advisor = 0; n_advisors = 0; n_advisors_woman = 0;
go-to: beweli_advisor_choice

@right_leadership
choose-if: right_leadership >= 50
on-arrival: in_right_leadership = 1; emali_dissent -= 5; pragmatist_dissent -= 5; hennigwellsow_advisor = 0; wissler_advisor = 0; wagenknecht_advisor = 0; mohamedali_advisor = 0; riexinger_advisor = 0; pellmann_advisor = 0; gohlke_advisor = 0; schwerdtner_advisor = 0; pantisano_advisor = 0; buenger_advisor = 0; lay_advisor = 0; kipping_advisor = 0; reichinnek_advisor = 0; vanaken_advisor = 0; schirdewan_advisor = 0; hoss_advisor = 0; gysi_advisor = 0; bartsch_advisor = 0; ramelow_advisor = 0; goerke_advisor = 0; n_advisors = 0; n_advisors_woman = 0;
