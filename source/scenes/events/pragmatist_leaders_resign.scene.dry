title: Pragmatist leaders resign
new-page: true 
subtitle: Pragmatist disagreements with our policies have grown too severe.
tags: event
view-if: pragmatist_dissent >= 80
on-arrival: {!

Q.urban_greens += 0.3*(Q.urban_linke/1)*(Q.pragmatist_strength/100);
Q.rural_greens += 0.3*(Q.rural_linke/1.2)*(Q.pragmatist_strength/100);
Q.upper_greens += 0.4*(Q.upper_linke/1.2)*(Q.pragmatist_strength/100);
Q.east_greens += 0.3*(Q.east_linke/1.2)*(Q.pragmatist_strength/100);
Q.youth_greens += 0.5*(Q.youth_linke/0.8)*(Q.pragmatist_strength/100);

Q.urban_spd += 0.4*(Q.urban_linke/1)*(Q.pragmatist_strength/100);
Q.rural_spd += 0.4*(Q.rural_linke/1.2)*(Q.pragmatist_strength/100);
Q.upper_spd += 0.5*(Q.upper_linke/1.2)*(Q.pragmatist_strength/100);
Q.east_spd += 0.3*(Q.east_linke/1.2)*(Q.pragmatist_strength/100);
Q.youth_spd += 0.3*(Q.youth_linke/0.8)*(Q.pragmatist_strength/100);

Q.urban_linke -= (Q.urban_linke/1)*(Q.pragmatist_strength/100);
Q.rural_linke -= (Q.rural_linke/1.2)*(Q.pragmatist_strength/100);
Q.upper_linke -= (Q.upper_linke/1.2)*(Q.pragmatist_strength/100);
Q.east_linke -= (Q.east_linke/1.2)*(Q.pragmatist_strength/100);
Q.youth_linke -= (Q.youth_linke/0.8)*(Q.pragmatist_strength/100);

Q.pragmatist_strength *= 0.1; 

if (Q.hennigwellsow_advisor == 1) Q.n_advisors -= 1; 
if (Q.gysi_advisor == 1) Q.n_advisors -= 1;
if (Q.ramelow_advisor == 1) Q.n_advisors -= 1;             
if (Q.bartsch_advisor == 1) Q.n_advisors -= 1; 
if (Q.goerke_advisor == 1) Q.n_advisors -= 1;
if (Q.hennigwellsow_advisor == 1) Q.n_advisors_woman -= 1;
Q.hennigwellsow_advisor = 0;
Q.gysi_advisor = 0;
Q.goerke_advisor = 0;
Q.bartsch_advisor = 0;
Q.ramelow_advisor = 0;

if (Q.hennigwellsow_advisor_b == 1) Q.n_advisors_b -= 1; 
if (Q.gysi_advisor_b == 1) Q.n_advisors_b -= 1;
if (Q.goerke_advisor_b == 1) Q.n_advisors_b -= 1;
if (Q.bartsch_advisor_b == 1) Q.n_advisors_b -= 1; 
if (Q.ramelow_advisor_b == 1) Q.n_advisors_b -= 1;
if (Q.hennigwellsow_advisor_b == 1) Q.n_advisors_b_woman -= 1;
Q.hennigwellsow_advisor_b = 0;
Q.goerke_advisor_b = 0;
Q.gysi_advisor_b = 0;
Q.ramelow_advisor_b = 0;
Q.bartsch_advisor_b = 0;

Q.pragmatist_left = 1;
!}
