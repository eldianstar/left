{!<tr><td><div class="box" style='background-color:#4C0B5F'> </div> !} Old Left: {!</td><td>!} [+ oldleft_c +]% {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#BC2D72'> </div> !} Movement Left: {!</td><td>!} [+ beweli_c +]% {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ff681d'> </div> !} Center: {!</td><td>!} [+ emali_c +]% {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ff5500'> </div> !} Pragmatists: {!</td><td>!} [+ pragmatist_c +]% {!</td></tr>!}

@leadership_election
title: Now, let us choose the Party Leadership.

- @left_leadership: The left wing of the party takes power.
- @progressive_leadership: The new leadership will represent the progressive centrist wings of the party.
- @right_leadership: The right wing of the party takes power.
- @hufeisen_leadership: The left and right wings have settled on a horshoe power sharing agreement.
- @vote_stalled: The vote reaches a deadlock

@left_leadership
choose-if: left_leadership >= 50 and (issue_feminism < 5 or oldleft_leader != "Wagenknecht")
on-arrival: in_left_leadership = 1; beweli_dissent -= 5; oldleft_dissent -= 5; hennigwellsow_advisor = 0; wissler_advisor = 0; wagenknecht_advisor = 0; mohamedali_advisor = 0; riexinger_advisor = 0; pellmann_advisor = 0; gohlke_advisor = 0; schwerdtner_advisor = 0; pantisano_advisor = 0; buenger_advisor = 0; lay_advisor = 0; kipping_advisor = 0; reichinnek_advisor = 0; vanaken_advisor = 0; schirdewan_advisor = 0; hoss_advisor = 0; gysi_advisor = 0; bartsch_advisor = 0; ramelow_advisor = 0; goerke_advisor = 0; n_advisors = 0; n_advisors_woman = 0;
go-to: oldleft_advisor_choice

@progressive_leadership
choose-if: progressive_leadership >= 50
on-arrival: in_progressive_leadership = 1; beweli_dissent -= 5; emali_dissent -= 5; hennigwellsow_advisor = 0; wissler_advisor = 0; wagenknecht_advisor = 0; mohamedali_advisor = 0; riexinger_advisor = 0; pellmann_advisor = 0; gohlke_advisor = 0; schwerdtner_advisor = 0; pantisano_advisor = 0; buenger_advisor = 0; lay_advisor = 0; kipping_advisor = 0; reichinnek_advisor = 0; vanaken_advisor = 0; schirdewan_advisor = 0; hoss_advisor = 0; gysi_advisor = 0; bartsch_advisor = 0; ramelow_advisor = 0; goerke_advisor = 0; n_advisors = 0; n_advisors_woman = 0;
go-to: beweli_advisor_choice

@right_leadership
choose-if: right_leadership >= 50
on-arrival: in_right_leadership = 1; emali_dissent -= 5; pragmatist_dissent -= 5; hennigwellsow_advisor = 0; wissler_advisor = 0; wagenknecht_advisor = 0; mohamedali_advisor = 0; riexinger_advisor = 0; pellmann_advisor = 0; gohlke_advisor = 0; schwerdtner_advisor = 0; pantisano_advisor = 0; buenger_advisor = 0; lay_advisor = 0; kipping_advisor = 0; reichinnek_advisor = 0; vanaken_advisor = 0; schirdewan_advisor = 0; hoss_advisor = 0; gysi_advisor = 0; bartsch_advisor = 0; ramelow_advisor = 0; goerke_advisor = 0; n_advisors = 0; n_advisors_woman = 0;
go-to: emali_advisor_choice

@hufeisen_leadership
choose-if: hufeisen_leadership >= 50 and (issue_antimilitarism < 5 or (oldleft_dissent < 10 and emali_dissent < 10))
on-arrival: in_hufeisen_leadership = 1; oldleft_dissent -= 5; emali_dissent -= 5; hennigwellsow_advisor = 0; wissler_advisor = 0; wagenknecht_advisor = 0; mohamedali_advisor = 0; riexinger_advisor = 0; pellmann_advisor = 0; gohlke_advisor = 0; schwerdtner_advisor = 0; pantisano_advisor = 0; buenger_advisor = 0; lay_advisor = 0; kipping_advisor = 0; reichinnek_advisor = 0; vanaken_advisor = 0; schirdewan_advisor = 0; hoss_advisor = 0; gysi_advisor = 0; bartsch_advisor = 0; ramelow_advisor = 0; goerke_advisor = 0; n_advisors = 0; n_advisors_woman = 0;
go-to: oldleft_advisor_choice

@vote_stalled
view-if: (hufeisen_leadership < 50 or (issue_antimilitarism >= 5 and (oldleft_dissent >= 10 or emali_dissent >= 10))) and (left_leadership < 50 and (issue_feminism >= 5 or oldleft_leader == "Wagenknecht")) and progressive_leadership < 50 and right_leadership < 50
on-arrival: oldleft_dissent += 10; emali_dissent += 10; beweli_dissent += 10; pragmatist_dissent += 10;

