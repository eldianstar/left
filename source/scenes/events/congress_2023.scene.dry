title: 2023 Augsburg Conference
subtitle: The Left holds its 9th Party Congress in Augsburg
new-page: true
tags: event
view-if: year == 2023 and month >= 11
set-jump: post_congress
max-visits: 1

= 2023 Augsburg Congress

Die Linke is holding its annual congress in Augsburg. The main focus is clearly going to be the upcoming European elections[? if wagenknecht_left == 1 and wagenknecht_left_congress == 0 :  as well as the exit of Sahra Wagenknecht from the party ?].

- @faction_algorithm: The delegates enter...

@faction_algorithm
on-arrival: {!

if (Q.wagenknecht_left == 1 && wagenknecht_left_congress == 0) {
   Q.beweli_dissent -= 6;
   Q.emali_dissent -= 6;
   Q.pragmatist_dissent -= 6;
   Q.wagenknecht_left_congress = 1;
}

Q.oldleft_votes = 0;
Q.beweli_votes = 0;
Q.pragmatist_votes = 0;
Q.emali_votes = 0;

Q.oldleft_urban = 1;
Q.oldleft_rural = 1;
Q.oldleft_youth = 1;
Q.oldleft_upper = 1;
Q.oldleft_east = 1;

Q.beweli_urban = 1;
Q.beweli_rural = 1;
Q.beweli_youth = 1;
Q.beweli_upper = 1;
Q.beweli_east = 1;

Q.emali_urban = 1;
Q.emali_rural = 1;
Q.emali_youth = 1;
Q.emali_upper = 1;
Q.emali_east = 1;

Q.pragmatist_urban = 1;
Q.pragmatist_rural = 1;
Q.pragmatist_youth = 1;
Q.pragmatist_upper = 1;
Q.pragmatist_east = 1;

var total_linke = 0;
var total_factions = 0;

// Calculate performance
var linke_performance = Q.linke_votes - Q.old_linke_performance;
if (Q.old_linke_performance) {
    Q.old_linke_performance = Q.linke_votes;
} else {
    Q.old_linke_performance = 26;
}
if (!linke_performance) {
    linke_performance = Q.linke_votes - Q.old_linke_performance;
}

console.log("linke performance delta:", linke_performance);

// Sum linke-normalized votes across all classes
for (var c of Q.classes) {
    total_linke += (Q[c + '_linke_normalized'] * Q[c]);
}
console.log("Total Linke weighted class vote:", total_linke);

// Loop through factions and classes
for (var faction of Q.factions) {
    Q[faction + '_votes'] = Q[faction + '_strength'];
    
    console.log(
        `[${faction}] strength:`,
        Q[faction + '_strength']
    );

    total_factions += Q[faction + '_votes'];
}

// Normalize to percentage
for (var faction of Q.factions) {
    Q[faction + '_votes'] = Math.round((Q[faction + '_votes'] / total_factions) * 100);
    console.log(`[${faction}] normalized vote %:`, Q[faction + '_votes']);
}
!}
go-to: post_congress

@post_congress
on-arrival: {!
// set old results
// election threshold constitutional reform
// banning parties
var new_faction_sum = 0;
for (var faction of Q.factions) {
    Q['old_' + faction + '_c'] = Q[faction + '_c'];
    Q[faction + '_c'] = Q[faction + '_votes'];
        // if we use decimals, then we might want to truncate the numbers
    if (Q.use_decimals) {
        Q[faction + '_c_disp'] = Q[faction+'_c'].toFixed(1);
    }  else {
            Q[faction + '_c_disp'] = Q[faction+'_c'];
    }
    Q['change_' + faction + '_c'] = Q[faction + '_c'] - Q['old_' + faction + '_c'];
    var sign = Q['change_' + faction + '_c'] > 0 ? '+'  : '';
    Q['str_change_' + faction] = sign + Q['change_' + faction + '_c'];//.toFixed(1);
}


Q.left_leadership = Q.oldleft_c+Q.beweli_c;
Q.progressive_leadership = Q.beweli_c+Q.emali_c;
Q.right_leadership = Q.emali_c+Q.pragmatist_c;
Q.hufeisen_leadership = Q.oldleft_c+Q.emali_c;
!}
on-display: {!
if (!Q.neorevisionism) {
    data = [
        {   "id": "oldleft",
            "legend": "Old Left",
            "name": "Old Left",
            "seats": Math.round(Q.oldleft_c*4.15),
        },
        {
            "id": "beweli",
            "legend": "Movement Left",
            "name": "Movement Left",
            "seats": Math.round(Q.beweli_c*4.15),
        },
        {
            "id": "emali",
            "legend": "Center",
            "name": "Center",
            "seats": Math.round(Q.emali_c*4.15),
        },
        {
            "id": "pragmatist",
            "legend": "Pragmatists",
            "name": "Pragmatists",
            "seats": Math.round(Q.pragmatist_c*4.15),
        },
];
}

if (window && d3) {
    var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

