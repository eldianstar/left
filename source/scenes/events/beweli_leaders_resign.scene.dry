Q.youth_linke -= (Q.youth_linke/1.2)*(Q.beweli_strength/100);

Q.beweli_strength *= 0.1; 

if (Q.schwerdtner_advisor == 1) Q.n_advisors -= 1; 
if (Q.pantisano_advisor == 1) Q.n_advisors -= 1;
if (Q.gohlke_advisor == 1) Q.n_advisors -= 1; 
