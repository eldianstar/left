if (Q.schwerdtner_advisor == 1) Q.n_advisors_woman -= 1;
if (Q.gohlke_advisor == 1) Q.n_advisors_woman -= 1;
if (Q.buenger_advisor == 1) Q.n_advisors_woman -= 1;
if (Q.wissler_advisor == 1 && Q.beweli_leader == "Wissler") Q.n_advisors_woman -= 1;
Q.schwerdtner_advisor = 0;
Q.pantisano_advisor = 0;
Q.gohlke_advisor = 0;
Q.buenger_advisor = 0;
if (Q.wissler_advisor == 1 && Q.beweli_leader == "Wissler") Q.wissler_advisor = 0;
if (Q.riexinger_advisor == 1 && Q.beweli_leader == "Wissler") Q.riexinger_advisor = 0;


if (Q.schwerdtner_advisor_b == 1) Q.n_advisors_b -= 1; 
if (Q.pantisano_advisor_b == 1) Q.n_advisors_b -= 1;
if (Q.gohlke_advisor_b == 1) Q.n_advisors_b -= 1; 
if (Q.buenger_advisor_b == 1) Q.n_advisors_b -= 1;
if (Q.wissler_advisor_b == 1 && Q.beweli_leader == "Wissler") Q.n_advisors_b -= 1;
if (Q.riexinger_advisor_b == 1 && Q.beweli_leader == "Wissler") Q.n_advisors_b -= 1;
if (Q.schwerdtner_advisor_b == 1) Q.n_advisors_b_woman -= 1;
if (Q.gohlke_advisor_b == 1) Q.n_advisors_b_woman -= 1;
if (Q.buenger_advisor_b == 1) Q.n_advisors_b_woman -= 1;
if (Q.wissler_advisor_b == 1 && Q.beweli_leader == "Wissler") Q.n_advisors_b_woman -= 1;
Q.schwerdtner_advisor_b = 0;
Q.pantisano_advisor_b = 0;
Q.gohlke_advisor_b = 0;
Q.buenger_advisor_b = 0;
if (Q.wissler_advisor_b == 1 && Q.beweli_leader == "Wissler") Q.wissler_advisor_b = 0;
if (Q.riexinger_advisor_b == 1 && Q.beweli_leader == "Wissler") Q.riexinger_advisor_b = 0;

Q.beweli_left = 1;
