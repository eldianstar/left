{!<tr><td><div class="box" style='background-color:#000000'> </div> !}<span style="color: [+ cdu_color +];">**CDU**</span>: {!</td><td>!} [+ cdu_meckvor_elections_vote +]% {!</td><td>!} [+ cdu_r_meckvor +]%  {!</td></tr>!}

