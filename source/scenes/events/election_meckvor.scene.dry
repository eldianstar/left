////////////////// calculate seats votes ///////////////////////////////

Q.spd_meckvor_elections_vote = Q.spd_votes*meckvor_adjustment_factors.spd;
Q.linke_meckvor_elections_vote = Q.linke_votes*meckvor_adjustment_factors.linke;
Q.fdp_meckvor_elections_vote = Q.fdp_votes*meckvor_adjustment_factors.fdp;
if (Q.issue_migration >= 5) meckvor_adjustment_factors.afd += 0.2;
Q.afd_meckvor_elections_vote = Q.afd_votes*meckvor_adjustment_factors.afd;
Q.cdu_meckvor_elections_vote = Q.cdu_votes*meckvor_adjustment_factors.cdu;
if (Q.issue_environment >= 5) meckvor_adjustment_factors.greens += 0.1;
Q.greens_meckvor_elections_vote = Q.greens_votes*meckvor_adjustment_factors.greens;
Q.bsw_meckvor_elections_vote = Q.bsw_votes*meckvor_adjustment_factors.bsw;

Q.total_votes_meckvor = Q.spd_meckvor_elections_vote + Q.linke_meckvor_elections_vote + Q.greens_meckvor_elections_vote + Q.fdp_meckvor_elections_vote + Q.cdu_meckvor_elections_vote + Q.afd_meckvor_elections_vote + Q.bsw_meckvor_elections_vote;

if (Q.total_votes_meckvor > 0) {
    Q.spd_meckvor_elections_vote = (Q.spd_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.linke_meckvor_elections_vote = (Q.linke_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.greens_meckvor_elections_vote = (Q.greens_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.fdp_meckvor_elections_vote = (Q.fdp_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.afd_meckvor_elections_vote = (Q.afd_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.cdu_meckvor_elections_vote = (Q.cdu_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.bsw_meckvor_elections_vote = (Q.bsw_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    let target = 9;
    Q.linke_meckvor_elections_vote = Math.round((Q.linke_meckvor_elections_vote + (target - Q.linke_meckvor_elections_vote) * 0.35) * 10) / 10;
    Q.total_votes_meckvor = Q.spd_meckvor_elections_vote + Q.linke_meckvor_elections_vote + Q.greens_meckvor_elections_vote + Q.fdp_meckvor_elections_vote + Q.afd_meckvor_elections_vote + Q.cdu_meckvor_elections_vote + Q.bsw_meckvor_elections_vote;
    Q.spd_meckvor_elections_vote = (Q.spd_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.linke_meckvor_elections_vote = (Q.linke_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.greens_meckvor_elections_vote = (Q.greens_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.fdp_meckvor_elections_vote = (Q.fdp_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.afd_meckvor_elections_vote = (Q.afd_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.cdu_meckvor_elections_vote = (Q.cdu_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
    Q.bsw_meckvor_elections_vote = (Q.bsw_meckvor_elections_vote / Q.total_votes_meckvor) * 100;
}

Q.spd_meckvor_elections_vote = (Q.spd_meckvor_elections_vote != undefined ? parseFloat(Q.spd_meckvor_elections_vote.toFixed(1)) : 0);
Q.linke_meckvor_elections_vote = (Q.linke_meckvor_elections_vote != undefined ? parseFloat(Q.linke_meckvor_elections_vote.toFixed(1)) : 0);
Q.greens_meckvor_elections_vote = (Q.greens_meckvor_elections_vote != undefined ? parseFloat(Q.greens_meckvor_elections_vote.toFixed(1)) : 0);
