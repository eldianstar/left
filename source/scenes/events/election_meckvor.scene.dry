on-arrival: youth_spd -= 0.2; youth_linke += 0.1; youth_greens += 0.1; meckvor_groko = 1; meckvor_traffic_light = 0; meckvor_rot_rot_grun = 0; meckvor_jamaica = 0; meckvor_rot_rot = 0; meckvor_kenya = 0; meckvor_schwarz_blau = 0; meckvor_tigerenten = 0; meckvor_kiwi = 0; meckvor_die_linke_maj = 0; meckvor_afd_maj = 0; meckvor_rot_grun = 0; meckvor_spd_maj = 0; meckvor_green_maj = 0; meckvor_cdu_maj = 0; meckvor_weimar_but_different = 0; meckvor_red_purple = 0; meckvor_brombeer = 0; meckvor_querfront = 0;

