function allocateSeats(percentages, totalSeats = 79) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_r_meckvor: Q.spd_r_meckvor,
    linke_r_meckvor: Q.linke_r_meckvor,
    greens_r_meckvor: Q.greens_r_meckvor,
    fdp_r_meckvor: Q.fdp_r_meckvor,
    afd_r_meckvor: Q.afd_r_meckvor,
    cdu_r_meckvor: Q.cdu_r_meckvor,
    bsw_r_meckvor: Q.bsw_r_meckvor,
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 79).toFixed(1));
}

///////////////////// potential coalition calculation /////////////////////////

Q.meckvor_pot_groko = parseFloat((Q.spd_r_meckvor + Q.cdu_r_meckvor).toFixed(1));
Q.meckvor_pot_traffic_light = parseFloat((Q.fdp_r_meckvor + Q.spd_r_meckvor + Q.greens_r_meckvor).toFixed(1));
Q.meckvor_pot_jamaica = parseFloat((Q.greens_r_meckvor + Q.cdu_r_meckvor + Q.fdp_r_meckvor).toFixed(1));
Q.meckvor_pot_rot_rot = parseFloat((Q.linke_r_meckvor + Q.spd_r_meckvor).toFixed(1));
Q.meckvor_pot_tigerenten = parseFloat((Q.cdu_r_meckvor + Q.fdp_r_meckvor).toFixed(1));
Q.meckvor_pot_kiwi = parseFloat((Q.cdu_r_meckvor + Q.greens_r_meckvor).toFixed(1));
Q.meckvor_pot_tigerenten = parseFloat((Q.cdu_r_meckvor + Q.fdp_r_meckvor).toFixed(1));
Q.meckvor_pot_die_linke_maj = parseFloat((Q.linke_r_meckvor).toFixed(1));
Q.meckvor_pot_die_linke_maj = parseFloat((Q.linke_r_meckvor).toFixed(1));
Q.meckvor_pot_afd_maj = parseFloat((Q.afd_r_meckvor).toFixed(1));
Q.meckvor_pot_rot_grun = parseFloat((Q.spd_r_meckvor + Q.greens_r_meckvor).toFixed(1));
Q.meckvor_pot_rot_rot_grun = parseFloat((Q.spd_r_meckvor + Q.greens_r_meckvor + Q.linke_r_meckvor).toFixed(1));
Q.meckvor_pot_spd_maj = parseFloat((Q.spd_r_meckvor).toFixed(1));
Q.meckvor_pot_green_maj = parseFloat((Q.greens_r_meckvor).toFixed(1));
Q.meckvor_pot_cdu_maj = parseFloat((Q.cdu_r_meckvor).toFixed(1));
Q.meckvor_pot_weimar_but_different = parseFloat((Q.cdu_r_meckvor + Q.fdp_r_meckvor + Q.spd_r_meckvor).toFixed(1));
Q.meckvor_pot_kenya = parseFloat((Q.cdu_r_meckvor + Q.greens_r_meckvor + Q.spd_r_meckvor).toFixed(1));
Q.meckvor_pot_schwarz_blau = parseFloat((Q.cdu_r_meckvor + Q.afd_r_meckvor).toFixed(1));
Q.meckvor_pot_red_purple = parseFloat((Q.bsw_r_meckvor + Q.linke_r_meckvor).toFixed(1));
Q.meckvor_pot_brombeer = parseFloat((Q.bsw_r_meckvor + Q.cdu_r_meckvor + Q.spd_r_meckvor).toFixed(1));
Q.meckvor_pot_querfront = parseFloat((Q.bsw_r_meckvor + Q.afd_r_meckvor).toFixed(1));

Q.linke_meckvor_elections_vote = (Q.linke_meckvor_elections_vote != undefined ? parseFloat(Q.linke_meckvor_elections_vote.toFixed(1)) : 0);
Q.spd_meckvor_elections_vote = (Q.spd_meckvor_elections_vote != undefined ? parseFloat(Q.spd_meckvor_elections_vote.toFixed(1)) : 0);
Q.spd_r_meckvor = (Q.spd_r_meckvor != undefined ? parseFloat(Q.spd_r_meckvor.toFixed(1)) : 0);

!}
on-display: {!
var data = [];

/////////////////////////////// push diagram data ////////////////////////////////////

if (Q.bsw_meckvor_elections_vote >= 5) {
    data.push({
        "id": "bsw",
        "legend": "BSW",
        "name": "BSW",
        "seats": Math.round(Q.bsw_r_meckvor * 0.79)
    });
}

if (Q.linke_meckvor_elections_vote >= 5) {
    data.push({
        "id": "linke",
        "legend": "Left",
        "name": "Left",
        "seats": Math.round(Q.linke_r_meckvor * 0.79)
    });
}

if (Q.spd_meckvor_elections_vote >= 5) {
    data.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Math.round(Q.spd_r_meckvor * 0.79)
    });
}

if (Q.greens_meckvor_elections_vote >= 5) {
    data.push({
        "id": "greens",
        "legend": "B90/Greens",
        "name": "B90/Greens",
        "seats": Math.round(Q.greens_r_meckvor * 0.79)
    });
}

if (Q.fdp_meckvor_elections_vote >= 5) {
    data.push({
        "id": "fdp",
        "legend": "FDP",
        "name": "FDP",
        "seats": Math.round(Q.fdp_r_meckvor * 0.79)
    });
}

if (Q.cdu_meckvor_elections_vote >= 5) {
    data.push({
        "id": "cdu",
        "legend": "CDU",
        "name": "CDU",
        "seats": Math.round(Q.cdu_r_meckvor * 0.79)
    });
}

if (Q.afd_meckvor_elections_vote >= 5) {
    data.push({
        "id": "afd",
        "legend": "AfD",
        "name": "AfD",
        "seats": Math.round(Q.afd_r_meckvor * 0.79)
    });
}
setTimeout(function() {
    if (window && window.d3) {
        var width = 500;
        var height = 500;
        var contentDiv = document.getElementById('content');

        if (!contentDiv) return; 

        var screenWidth = contentDiv.offsetWidth;
        if (screenWidth < width - 50) {
            width = screenWidth - 50;
            height = width;
            var svgElement = document.getElementById("meckvor_landtag");
            if (svgElement) {
                svgElement.style.height = (screenWidth / 2) + "px";
            }
        }

        var parliament = d3.parliament();
        parliament.width(width).height(height).innerRadiusCoef(0.4);
        parliament.enter.fromCenter(true).smallToBig(true);
        parliament.exit.toCenter(false).bigToSmall(true);

        d3.select("#meckvor_landtag").selectAll("*").remove();
        d3.select("#meckvor_landtag").datum(data).call(parliament);
    }
}, 79);

!}

