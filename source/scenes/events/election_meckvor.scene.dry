Q.cdu_meckvor_elections_vote = 0;
Q.bsw_meckvor_elections_vote = 0;

///////////////////// class-based proportions votes ////////////////////////////////

if (Q.east_linke > (Q.votes_linke + 3)) meckvor_adjustment_factors.linke += 0.1;
if (Q.east_linke > (Q.votes_linke + 3)) meckvor_adjustment_factors.linke += 0.1;
if (Q.east_linke > (Q.votes_linke + 6)) meckvor_adjustment_factors.linke += 0.1;
