title: Mecklenburg-Vorpommern state election
subtitle: The people of Mecklenburg-Vorpommern head to the polls..
view-if: (year = next_election_year_meckvor and month >= next_election_month_meckvor) or (year > next_election_year_meckvor)
new-page: true
tags: event
on-arrival: meckvor_election_seen += 1; meckvor_election_seen_time = time; meckvor_most_recent = time;
on-departure: {! 
Q.next_election_year_meckvor = Q.next_election_year_meckvor + 5; 
Q.n_elections_meckvor += 1;
Q.next_election_time_meckvor = Q.time + 60;
!}
priority: 2
face-image: img/meckvor.png

= Mecklenburg-Vorpommern state election, [+ month : month +] [+ year +]

The regularly scheduled elections for the Mecklenburg-Vorpommern Landtag are to take place. The incumbent government is a [? if meckvor_groko = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span> ?][? if meckvor_traffic_light = 1 : <span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ fdp_color +];">Yellow</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if meckvor_rot_rot_grun = 1 : <span style="color: [+ linke_color +];">Red</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if meckvor_jamaica = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ fdp_color +];">Yellow</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if meckvor_rot_rot = 1 : <span style="color: [+ linke_color +];">Red</span>-<span style="color: [+ spd_color +];">Red</span> ?][? if meckvor_kenya = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if meckvor_schwarz_blau = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ afd_color +];">Blue</span> ?][? if meckvor_tigerenten = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ fdp_color +];">Yellow</span> ?][? if meckvor_kiwi = 1 : <span style="color: [+ greens_color +];">Green</span>-<span style="color: [+ cdu_color +];">Black</span> ?][? if meckvor_die_linke_maj = 1 : <span style="color: [+ linke_color +];">Red</span> ?][? if meckvor_afd_maj = 1 : <span style="color: [+ afd_color +];">Blue</span> ?][? if meckvor_rot_grun = 1 : <span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if meckvor_spd_maj = 1 : <span style="color: [+ spd_color +];">Red</span> ?][? if meckvor_green_maj = 1 : <span style="color: [+ greens_color +];">Green</span> ?][? if meckvor_cdu_maj = 1 : <span style="color: [+ cdu_color +];">Black</span> ?][? if meckvor_weimar_but_different = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ fdp_color +];">Yellow</span> ?] government.

- @meckvor: May we do our best...

@meckvor
on-arrival: {!

var meckvor_adjustment_factors = {
    spd: 1.35,
    linke: 1.65,
    fdp: 0.55,
    cdu: 0.75,
    afd: 1.55,
    greens: 0.35,
    bsw: 1.25,
};

Q.spd_r_meckvor = 0;
Q.linke_r_meckvor = 0;
Q.cdu_r_meckvor = 0;
Q.greens_r_meckvor = 0;
Q.afd_r_meckvor = 0;
Q.fdp_r_meckvor = 0;
Q.bsw_r_meckvor = 0;

Q.spd_meckvor_elections_vote = 0;
Q.linke_meckvor_elections_vote = 0;
Q.fdp_meckvor_elections_vote = 0;
Q.afd_meckvor_elections_vote = 0;
