tags: event
on-arrival: berlin_election_seen += 1 if berlin_election_seen; berlin_election_seen = 1 if not berlin_election_seen; berlin_election_seen_time = time; berlin_most_recent = time; berlin_groko = 0; berl[...]
priority: 2
face-image: img/berlin.png

= Wahl zum Berlin Abgeordnetenhaus, [+ month : month +] [+ year +]

The regularly scheduled elections for the Berlin Abgeordnetenhaus are to take place. The incumbent government is a <span style="color: [+ linke_colour +];">Rot</span>-<span style="color: [+ spd_colour[...]
  
Concurrent to this, a expropiation referendum which will affect 12 businesses will take place, and we are confident that it will end in a victory for the Yes side. The Borough council elections are al[...]

- @berlin: May we do our best...

@berlin
on-arrival: {!

var berlin_adjustment_factors = {
    spd: 1.0,
    linke: 0.92,
    fdp: 0.95,
    cdu: 1.0,
    afd: 0.85,
    greens: 0.62,
};

Q.spd_r_berlin = 0;
Q.linke_r_berlin = 0;
Q.cdu_r_berlin = 0;
Q.greens_r_berlin = 0;
Q.afd_r_berlin = 0;
Q.fdp_r_berlin = 0;

Q.spd_berlin_elections_vote = 0;
Q.linke_berlin_elections_vote = 0;
Q.fdp_berlin_elections_vote = 0;
Q.afd_berlin_elections_vote = 0;
Q.greens_berlin_elections_vote = 0;
Q.cdu_berlin_elections_vote = 0;

if (Q.young_linke_normalized + Q.urban_linke_normalized >= 30) berlin_adjustment_factors.linke += 0.08;
if (Q.workers_linke_normalized >= 70) berlin_adjustment_factors.linke += 0.06;
if (Q.issue_environment >= 5) berlin_adjustment_factors.greens += 0.12;
if (Q.issue_environment >= 7) berlin_adjustment_factors.greens += 0.08;
if (Q.young_spd_normalized + Q.urban_spd_normalized >= 35) berlin_adjustment_factors.spd += 0.05;

Q.spd_berlin_elections_vote = Q.spd_votes*berlin_adjustment_factors.spd;
Q.linke_berlin_elections_vote = Q.linke_votes*berlin_adjustment_factors.linke;
Q.fdp_berlin_elections_vote = Q.fdp_votes*berlin_adjustment_factors.fdp;
if (Q.rise_of_afd) berlin_adjustment_factors.afd += 0.15;
Q.afd_berlin_elections_vote = Q.afd_votes*berlin_adjustment_factors.afd;
Q.cdu_berlin_elections_vote = Q.cdu_votes*berlin_adjustment_factors.cdu;
Q.greens_berlin_elections_vote = Q.greens_votes*berlin_adjustment_factors.greens;

Q.total_votes_berlin = Q.spd_berlin_elections_vote + Q.linke_berlin_elections_vote + Q.greens_berlin_elections_vote + Q.fdp_berlin_elections_vote + Q.cdu_berlin_elections_vote + Q.afd_berlin_elections[...]

if (Q.total_votes_berlin > 0) {
    Q.spd_berlin_elections_vote = (Q.spd_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.linke_berlin_elections_vote = (Q.linke_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.greens_berlin_elections_vote = (Q.greens_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.fdp_berlin_elections_vote = (Q.fdp_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.afd_berlin_elections_vote = (Q.afd_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.cdu_berlin_elections_vote = (Q.cdu_berlin_elections_vote / Q.total_votes_berlin) * 100;
    let target = 24.1;
    Q.spd_berlin_elections_vote = Math.round((Q.spd_berlin_elections_vote + (target - Q.spd_berlin_elections_vote) * 0.25) * 10) / 10;
    Q.total_votes_berlin = Q.spd_berlin_elections_vote + Q.linke_berlin_elections_vote + Q.greens_berlin_elections_vote + Q.fdp_berlin_elections_vote + Q.afd_berlin_elections_vote + Q.cdu_berlin_elect[...]
    Q.spd_berlin_elections_vote = (Q.spd_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.linke_berlin_elections_vote = (Q.linke_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.greens_berlin_elections_vote = (Q.greens_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.fdp_berlin_elections_vote = (Q.fdp_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.afd_berlin_elections_vote = (Q.afd_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.cdu_berlin_elections_vote = (Q.cdu_berlin_elections_vote / Q.total_votes_berlin) * 100;
}

Q.spd_berlin_elections_vote = (Q.spd_berlin_elections_vote != undefined ? parseFloat(Q.spd_berlin_elections_vote.toFixed(1)) : 0);
Q.linke_berlin_elections_vote = (Q.linke_berlin_elections_vote != undefined ? parseFloat(Q.linke_berlin_elections_vote.toFixed(1)) : 0);
Q.greens_berlin_elections_vote = (Q.greens_berlin_elections_vote != undefined ? parseFloat(Q.greens_berlin_elections_vote.toFixed(1)) : 0);
Q.fdp_berlin_elections_vote = (Q.fdp_berlin_elections_vote != undefined ? parseFloat(Q.fdp_berlin_elections_vote.toFixed(1)) : 0);
Q.afd_berlin_elections_vote = (Q.afd_berlin_elections_vote != undefined ? parseFloat(Q.afd_berlin_elections_vote.toFixed(1)) : 0);
Q.cdu_berlin_elections_vote = (Q.cdu_berlin_elections_vote != undefined ? parseFloat(Q.cdu_berlin_elections_vote.toFixed(1)) : 0);

if (Q.spd_berlin_elections_vote >= 1.4) Q.spd_r_berlin = Q.spd_berlin_elections_vote;
if (Q.linke_berlin_elections_vote >= 1.4) Q.linke_r_berlin = Q.linke_berlin_elections_vote;
if (Q.greens_berlin_elections_vote >= 1.4) Q.greens_r_berlin = Q.greens_berlin_elections_vote;
if (Q.fdp_berlin_elections_vote >= 1.4) Q.fdp_r_berlin = Q.fdp_berlin_elections_vote;
if (Q.afd_berlin_elections_vote >= 1.4) Q.afd_r_berlin = Q.afd_berlin_elections_vote;
if (Q.cdu_berlin_elections_vote >= 1.4) Q.cdu_r_berlin = Q.cdu_berlin_elections_vote;

var berlin_adjustment_r_factors = {
    spd: 1.0,
    linke: 0.92,
    fdp: 0.95,
    cdu: 1.0,
    afd: 0.85,
    greens: 0.62,
};

if (Q.young_linke_normalized + Q.urban_linke_normalized >= 30) berlin_adjustment_r_factors.linke += 0.08;
if (Q.workers_linke_normalized >= 70) berlin_adjustment_r_factors.linke += 0.06;
if (Q.issue_environment >= 5) berlin_adjustment_r_factors.greens += 0.12;
if (Q.issue_environment >= 7) berlin_adjustment_r_factors.greens += 0.08;
if (Q.young_spd_normalized + Q.urban_spd_normalized >= 35) berlin_adjustment_r_factors.spd += 0.05;

Q.spd_r_berlin = Q.spd_votes*berlin_adjustment_r_factors.spd;
Q.linke_r_berlin = Q.linke_votes*berlin_adjustment_r_factors.linke;
Q.fdp_r_berlin = Q.fdp_votes*berlin_adjustment_r_factors.fdp;
if (Q.rise_of_afd) berlin_adjustment_r_factors.afd += 0.15;
Q.afd_r_berlin = Q.afd_votes*berlin_adjustment_r_factors.afd;
Q.cdu_r_berlin = Q.cdu_votes*berlin_adjustment_r_factors.cdu;
Q.greens_r_berlin = Q.greens_votes*berlin_adjustment_r_factors.greens;

Q.total_r_berlin = 0;

if (Q.spd_r_berlin) Q.total_r_berlin += Q.spd_r_berlin;
if (Q.linke_r_berlin) Q.total_r_berlin += Q.linke_r_berlin;
if (Q.greens_r_berlin) Q.total_r_berlin += Q.greens_r_berlin;
if (Q.fdp_r_berlin) Q.total_r_berlin += Q.fdp_r_berlin;
if (Q.afd_r_berlin) Q.total_r_berlin += Q.afd_r_berlin;
if (Q.cdu_r_berlin) Q.total_r_berlin += Q.cdu_r_berlin;

if (Q.total_r_berlin > 0) {
    Q.spd_r_berlin = (Q.spd_r_berlin / Q.total_r_berlin) * 100;
    Q.linke_r_berlin = (Q.linke_r_berlin / Q.total_r_berlin) * 100;
    Q.greens_r_berlin = (Q.greens_r_berlin / Q.total_r_berlin) * 100;
    Q.fdp_r_berlin = (Q.fdp_r_berlin / Q.total_r_berlin) * 100;
    Q.afd_r_berlin = (Q.afd_r_berlin / Q.total_r_berlin) * 100;
    Q.cdu_r_berlin = (Q.cdu_r_berlin / Q.total_r_berlin) * 100;
}

function allocateSeats(percentages, totalSeats = 147) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_r_berlin: Q.spd_r_berlin,
    linke_r_berlin: Q.linke_r_berlin,
    greens_r_berlin: Q.greens_r_berlin,
    fdp_r_berlin: Q.fdp_r_berlin,
    afd_r_berlin: Q.afd_r_berlin,
    cdu_r_berlin: Q.cdu_r_berlin,
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 147).toFixed(1));
}

Q.groko_berlin = parseFloat((Q.spd_r_berlin + Q.cdu_r_berlin).toFixed(1));
Q.traffic_light_berlin = parseFloat((Q.fdp_r_berlin + Q.spd_r_berlin + Q.greens_r_berlin).toFixed(1));
Q.jamaica_berlin = parseFloat((Q.greens_r_berlin + Q.cdu_r_berlin + Q.fdp_r_berlin).toFixed(1));
Q.rot_rot_berlin = parseFloat((Q.linke_r_berlin + Q.spd_r_berlin).toFixed(1));
Q.tigerenten_berlin = parseFloat((Q.cdu_r_berlin + Q.fdp_r_berlin).toFixed(1));
Q.kiwi_berlin = parseFloat((Q.cdu_r_berlin + Q.greens_r_berlin).toFixed(1));
Q.tigerenten_berlin = parseFloat((Q.cdu_r_berlin + Q.fdp_r_berlin).toFixed(1));
Q.die_linke_maj_berlin = parseFloat((Q.linke_r_berlin).toFixed(1));
Q.die_linke_maj_berlin = parseFloat((Q.linke_r_berlin).toFixed(1));
Q.afd_maj_berlin = parseFloat((Q.afd_r_berlin).toFixed(1));
Q.rot_grun_berlin = parseFloat((Q.spd_r_berlin + Q.greens_r_berlin).toFixed(1));
Q.rot_rot_grun_berlin = parseFloat((Q.spd_r_berlin + Q.greens_r_berlin + Q.linke_r_berlin).toFixed(1));
Q.spd_maj_berlin = parseFloat((Q.spd_r_berlin).toFixed(1));
Q.green_maj_berlin = parseFloat((Q.greens_r_berlin).toFixed(1));
Q.cdu_maj_berlin = parseFloat((Q.cdu_r_berlin).toFixed(1));
Q.weimar_but_different_berlin = parseFloat((Q.cdu_r_berlin + Q.fdp_r_berlin + Q.spd_r_berlin).toFixed(1));

Q.linke_berlin_elections_vote = (Q.linke_berlin_elections_vote != undefined ? parseFloat(Q.linke_berlin_elections_vote.toFixed(1)) : 0);
Q.spd_berlin_elections_vote = (Q.spd_berlin_elections_vote != undefined ? parseFloat(Q.spd_berlin_elections_vote.toFixed(1)) : 0);
Q.spd_r_berlin = (Q.spd_r_berlin != undefined ? parseFloat(Q.spd_r_berlin.toFixed(1)) : 0);

!}
on-display: {!
var data = [];

if (Q.linke_berlin_elections_vote >= 5) {
    data.push({
        "id": "linke",
        "legend": "Left",
        "name": "Left",
        "seats": Math.round(Q.linke_r_berlin * 0.96)
    });
}

if (Q.spd_berlin_elections_vote >= 5) {
    data.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Math.round(Q.spd_r_berlin * 0.96)
    });
}

if (Q.greens_berlin_elections_vote >= 5) {
    data.push({
        "id": "greens",
        "legend": "B90/Greens",
        "name": "B90/Greens",
        "seats": Math.round(Q.greens_r_berlin * 0.96)
    });
}

if (Q.fdp_berlin_elections_vote >= 5) {
    data.push({
        "id": "fdp",
        "legend": "FDP",
        "name": "FDP",
        "seats": Math.round(Q.fdp_r_berlin * 0.96)
    });
}

if (Q.cdu_berlin_elections_vote >= 5) {
    data.push({
        "id": "cdu",
        "legend": "CDU",
        "name": "CDU",
        "seats": Math.round(Q.cdu_r_berlin * 0.96)
    });
}

if (Q.afd_berlin_elections_vote >= 5) {
    data.push({
        "id": "afd",
        "legend": "AfD",
        "name": "AfD",
        "seats": Math.round(Q.afd_r_berlin * 0.96)
    });
}
setTimeout(function() {
    if (window && window.d3) {
        var width = 500;
        var height = 500;
        var contentDiv = document.getElementById('content');

        if (!contentDiv) return; 

        var screenWidth = contentDiv.offsetWidth;
        if (screenWidth < width - 50) {
            width = screenWidth - 50;
            height = width;
            var svgElement = document.getElementById("berlin_landtag");
            if (svgElement) {
                svgElement.style.height = (screenWidth / 2) + "px";
            }
        }

        var parliament = d3.parliament();
        parliament.width(width).height(height).innerRadiusCoef(0.4);
        parliament.enter.fromCenter(true).smallToBig(true);
        parliament.exit.toCenter(false).bigToSmall(true);

        d3.select("#berlin_landtag").selectAll("*").remove();
        d3.select("#berlin_landtag").datum(data).call(parliament);
    }
}, 147);
!}

