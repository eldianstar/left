title: Berlin state election
subtitle: The people of Berlin head to the polls..
view-if: (year = next_election_year_berlin and month >= next_election_month_berlin) or (year > next_election_year_berlin)
new-page: true
tags: event
on-arrival: berlin_election_seen += 1; berlin_election_seen_time = time; berlin_most_recent = time;
on-departure: {! 
Q.next_election_year_berlin = Q.next_election_year_berlin + 4; 
Q.n_elections_berlin += 1;
Q.next_election_time_berlin = Q.time + 48;
!}
priority: 2
face-image: img/berlin.png

= Berlin state election, [+ month : month +] [+ year +]

The regularly scheduled elections for the Berlin Abgeordnetenhaus are to take place. The incumbent government is a [? if berlin_groko = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span> ?][? if berlin_traffic_light = 1 : <span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ fdp_color +];">Yellow</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if berlin_rot_rot_grun = 1 : <span style="color: [+ linke_color +];">Red</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if berlin_jamaica = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ fdp_color +];">Yellow</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if berlin_rot_rot = 1 : <span style="color: [+ linke_color +];">Red</span>-<span style="color: [+ spd_color +];">Red</span> ?][? if berlin_kenya = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if berlin_schwarz_blau = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ afd_color +];">Blue</span> ?][? if berlin_tigerenten = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ fdp_color +];">Yellow</span> ?][? if berlin_kiwi = 1 : <span style="color: [+ greens_color +];">Green</span>-<span style="color: [+ cdu_color +];">Black</span> ?][? if berlin_die_linke_maj = 1 : <span style="color: [+ linke_color +];">Red</span> ?][? if berlin_afd_maj = 1 : <span style="color: [+ afd_color +];">Blue</span> ?][? if berlin_rot_grun = 1 : <span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if berlin_spd_maj = 1 : <span style="color: [+ spd_color +];">Red</span> ?][? if berlin_green_maj = 1 : <span style="color: [+ greens_color +];">Green</span> ?][? if berlin_cdu_maj = 1 : <span style="color: [+ cdu_color +];">Black</span> ?][? if berlin_weimar_but_different = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ fdp_color +];">Yellow</span> ?] government.

[? if year < 2023 : Concurrent to this, a expropiation referendum which will affect 12 businesses will take place, and we are confident that it will end in a victory for the Yes side. The Borough council elections are also held in the same day. Lot of things. ?] Now, we have to go to the voting..

- @berlin: May we do our best...

@berlin
face-image: img/berlin_map.jpg
on-arrival: {!

var berlin_adjustment_factors = {
    spd: 0.86,
    linke: 1.8,
    fdp: 0.65,
    cdu: 0.65,
    afd: 0.70,
    greens: 1.09,
    bsw: 1.0,
};

Q.spd_r_berlin = 0;
Q.linke_r_berlin = 0;
Q.cdu_r_berlin = 0;
Q.greens_r_berlin = 0;
Q.afd_r_berlin = 0;
Q.fdp_r_berlin = 0;
Q.bsw_r_berlin = 0;

Q.spd_berlin_elections_vote = 0;
Q.linke_berlin_elections_vote = 0;
Q.fdp_berlin_elections_vote = 0;
Q.afd_berlin_elections_vote = 0;
Q.greens_berlin_elections_vote = 0;
Q.cdu_berlin_elections_vote = 0;
Q.bsw_berlin_elections_vote = 0;

///////////////////// class-based proportions votes ////////////////////////////////

if (Q.youth_linke_normalized + Q.urban_linke_normalized >= 30) berlin_adjustment_factors.linke += 0.1;
if (Q.urban_linke_normalized >= 70) berlin_adjustment_factors.linke += 0.1;
if (Q.urban_linke > (Q.votes_linke + 3)) berlin_adjustment_factors.linke += 0.1;
if (Q.east_linke > (Q.votes_linke + 3)) berlin_adjustment_factors.linke += 0.1;
if (Q.urban_linke > (Q.votes_linke + 6)) berlin_adjustment_factors.linke += 0.1;
if (Q.east_linke > (Q.votes_linke + 6)) berlin_adjustment_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 6)) berlin_adjustment_factors.linke += 0.05;
if (Q.urban_linke > (Q.votes_linke + 15)) berlin_adjustment_factors.linke += 0.1;
if (Q.east_linke > (Q.votes_linke + 15)) berlin_adjustment_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 15)) berlin_adjustment_factors.linke += 0.05;

if (Q.urban_spd > (Q.votes_spd + 3)) berlin_adjustment_factors.spd += 0.1;
if (Q.east_spd > (Q.votes_spd + 3)) berlin_adjustment_factors.spd += 0.1;
if (Q.urban_spd > (Q.votes_spd + 6)) berlin_adjustment_factors.spd += 0.1;
if (Q.east_spd > (Q.votes_spd + 6)) berlin_adjustment_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 6)) berlin_adjustment_factors.spd += 0.05;
if (Q.urban_spd > (Q.votes_spd + 15)) berlin_adjustment_factors.spd += 0.1;
if (Q.east_spd > (Q.votes_spd + 15)) berlin_adjustment_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 15)) berlin_adjustment_factors.spd += 0.05;

if (Q.urban_greens > (Q.votes_greens + 3)) berlin_adjustment_factors.greens += 0.1;
if (Q.east_greens > (Q.votes_greens + 3)) berlin_adjustment_factors.greens += 0.1;
if (Q.urban_greens > (Q.votes_greens + 6)) berlin_adjustment_factors.greens += 0.1;
if (Q.east_greens > (Q.votes_greens + 6)) berlin_adjustment_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 6)) berlin_adjustment_factors.greens += 0.05;
if (Q.urban_greens > (Q.votes_greens + 15)) berlin_adjustment_factors.greens += 0.1;
if (Q.east_greens > (Q.votes_greens + 15)) berlin_adjustment_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 15)) berlin_adjustment_factors.greens += 0.05;

if (Q.urban_fdp > (Q.votes_fdp + 3)) berlin_adjustment_factors.fdp += 0.1;
if (Q.east_fdp > (Q.votes_fdp + 3)) berlin_adjustment_factors.fdp += 0.1;
if (Q.urban_fdp > (Q.votes_fdp + 6)) berlin_adjustment_factors.fdp += 0.1;
if (Q.east_fdp > (Q.votes_fdp + 6)) berlin_adjustment_factors.fdp += 0.1;
if (Q.youth_fdp > (Q.votes_fdp + 6)) berlin_adjustment_factors.fdp += 0.05;
if (Q.urban_fdp > (Q.votes_fdp + 15)) berlin_adjustment_factors.fdp += 0.1;
if (Q.east_fdp > (Q.votes_fdp + 15)) berlin_adjustment_factors.fdp += 0.1;
if (Q.youth_fdp > (Q.votes_fdp + 15)) berlin_adjustment_factors.fdp += 0.05;

if (Q.urban_cdu > (Q.votes_cdu + 3)) berlin_adjustment_factors.cdu += 0.1;
if (Q.east_cdu > (Q.votes_cdu + 3)) berlin_adjustment_factors.cdu += 0.1;
if (Q.urban_cdu > (Q.votes_cdu + 6)) berlin_adjustment_factors.cdu += 0.1;
if (Q.east_cdu > (Q.votes_cdu + 6)) berlin_adjustment_factors.cdu += 0.1;
if (Q.youth_cdu > (Q.votes_cdu + 6)) berlin_adjustment_factors.cdu += 0.05;
if (Q.urban_cdu > (Q.votes_cdu + 15)) berlin_adjustment_factors.cdu += 0.1;
if (Q.east_cdu > (Q.votes_cdu + 15)) berlin_adjustment_factors.cdu += 0.1;
if (Q.youth_cdu > (Q.votes_cdu + 15)) berlin_adjustment_factors.cdu += 0.05;

if (Q.urban_afd > (Q.votes_afd + 3)) berlin_adjustment_factors.afd += 0.1;
if (Q.east_afd > (Q.votes_afd + 3)) berlin_adjustment_factors.afd += 0.1;
if (Q.urban_afd > (Q.votes_afd + 6)) berlin_adjustment_factors.afd += 0.1;
if (Q.east_afd > (Q.votes_afd + 6)) berlin_adjustment_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 6)) berlin_adjustment_factors.afd += 0.05;
if (Q.urban_afd > (Q.votes_afd + 15)) berlin_adjustment_factors.afd += 0.1;
if (Q.east_afd > (Q.votes_afd + 15)) berlin_adjustment_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 15)) berlin_adjustment_factors.afd += 0.05;

////////////////// calculate seats votes ///////////////////////////////

Q.spd_berlin_elections_vote = Q.spd_votes*berlin_adjustment_factors.spd;
Q.linke_berlin_elections_vote = Q.linke_votes*berlin_adjustment_factors.linke;
Q.fdp_berlin_elections_vote = Q.fdp_votes*berlin_adjustment_factors.fdp;
if (Q.issue_migration >= 5) berlin_adjustment_factors.afd += 0.2;
Q.afd_berlin_elections_vote = Q.afd_votes*berlin_adjustment_factors.afd;
Q.cdu_berlin_elections_vote = Q.cdu_votes*berlin_adjustment_factors.cdu;
if (Q.issue_environment >= 5) berlin_adjustment_factors.greens += 0.1;
Q.greens_berlin_elections_vote = Q.greens_votes*berlin_adjustment_factors.greens;
Q.bsw_berlin_elections_vote = Q.bsw_votes*berlin_adjustment_factors.bsw;

Q.total_votes_berlin = Q.spd_berlin_elections_vote + Q.linke_berlin_elections_vote + Q.greens_berlin_elections_vote + Q.fdp_berlin_elections_vote + Q.cdu_berlin_elections_vote + Q.afd_berlin_elections_vote + Q.bsw_berlin_elections_vote;

if (Q.total_votes_berlin > 0) {
    Q.spd_berlin_elections_vote = (Q.spd_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.linke_berlin_elections_vote = (Q.linke_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.greens_berlin_elections_vote = (Q.greens_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.fdp_berlin_elections_vote = (Q.fdp_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.afd_berlin_elections_vote = (Q.afd_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.cdu_berlin_elections_vote = (Q.cdu_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.bsw_berlin_elections_vote = (Q.bsw_berlin_elections_vote / Q.total_votes_berlin) * 100;
    let target = 14;
    Q.linke_berlin_elections_vote = Math.round((Q.linke_berlin_elections_vote + (target - Q.linke_berlin_elections_vote) * 0.35) * 10) / 10;
    Q.total_votes_berlin = Q.spd_berlin_elections_vote + Q.linke_berlin_elections_vote + Q.greens_berlin_elections_vote + Q.fdp_berlin_elections_vote + Q.afd_berlin_elections_vote + Q.cdu_berlin_elections_vote;
    Q.spd_berlin_elections_vote = (Q.spd_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.linke_berlin_elections_vote = (Q.linke_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.greens_berlin_elections_vote = (Q.greens_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.fdp_berlin_elections_vote = (Q.fdp_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.afd_berlin_elections_vote = (Q.afd_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.cdu_berlin_elections_vote = (Q.cdu_berlin_elections_vote / Q.total_votes_berlin) * 100;
    Q.bsw_berlin_elections_vote = (Q.bsw_berlin_elections_vote / Q.total_votes_berlin) * 100;
}

Q.spd_berlin_elections_vote = (Q.spd_berlin_elections_vote != undefined ? parseFloat(Q.spd_berlin_elections_vote.toFixed(1)) : 0);
Q.linke_berlin_elections_vote = (Q.linke_berlin_elections_vote != undefined ? parseFloat(Q.linke_berlin_elections_vote.toFixed(1)) : 0);
Q.greens_berlin_elections_vote = (Q.greens_berlin_elections_vote != undefined ? parseFloat(Q.greens_berlin_elections_vote.toFixed(1)) : 0);
Q.fdp_berlin_elections_vote = (Q.fdp_berlin_elections_vote != undefined ? parseFloat(Q.fdp_berlin_elections_vote.toFixed(1)) : 0);
Q.afd_berlin_elections_vote = (Q.afd_berlin_elections_vote != undefined ? parseFloat(Q.afd_berlin_elections_vote.toFixed(1)) : 0);
Q.cdu_berlin_elections_vote = (Q.cdu_berlin_elections_vote != undefined ? parseFloat(Q.cdu_berlin_elections_vote.toFixed(1)) : 0);
Q.bsw_berlin_elections_vote = (Q.bsw_berlin_elections_vote != undefined ? parseFloat(Q.bsw_berlin_elections_vote.toFixed(1)) : 0);

if (Q.spd_berlin_elections_vote >= 1.4) Q.spd_r_berlin = Q.spd_berlin_elections_vote;
if (Q.linke_berlin_elections_vote >= 1.4) Q.linke_r_berlin = Q.linke_berlin_elections_vote;
if (Q.greens_berlin_elections_vote >= 1.4) Q.greens_r_berlin = Q.greens_berlin_elections_vote;
if (Q.fdp_berlin_elections_vote >= 1.4) Q.fdp_r_berlin = Q.fdp_berlin_elections_vote;
if (Q.afd_berlin_elections_vote >= 1.4) Q.afd_r_berlin = Q.afd_berlin_elections_vote;
if (Q.cdu_berlin_elections_vote >= 1.4) Q.cdu_r_berlin = Q.cdu_berlin_elections_vote;
if (Q.bsw_berlin_elections_vote >= 1.4) Q.bsw_r_berlin = Q.bsw_berlin_elections_vote;

/////////////////////////// adj factors seats ////////////////////////////

var berlin_adjustment_r_factors = {
    spd: 0.86,
    linke: 1.8,
    fdp: 0.65,
    cdu: 0.65,
    afd: 0.70,
    greens: 1.09,
    bsw: 1.0,
};

//////////////////////////// class based seats ///////////////////////////////

if (Q.youth_linke_normalized + Q.urban_linke_normalized >= 30) berlin_adjustment_r_factors.linke += 0.1;
if (Q.urban_linke_normalized >= 70) berlin_adjustment_r_factors.linke += 0.1;
if (Q.youth_linke_normalized + Q.urban_linke_normalized >= 30) berlin_adjustment_r_factors.linke += 0.1;
if (Q.urban_linke_normalized >= 70) berlin_adjustment_r_factors.linke += 0.1;
if (Q.urban_linke > (Q.votes_linke + 3)) berlin_adjustment_r_factors.linke += 0.1;
if (Q.east_linke > (Q.votes_linke + 3)) berlin_adjustment_r_factors.linke += 0.1;
if (Q.urban_linke > (Q.votes_linke + 6)) berlin_adjustment_r_factors.linke += 0.1;
if (Q.east_linke > (Q.votes_linke + 6)) berlin_adjustment_r_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 6)) berlin_adjustment_r_factors.linke += 0.05;
if (Q.urban_linke > (Q.votes_linke + 15)) berlin_adjustment_r_factors.linke += 0.1;
if (Q.east_linke > (Q.votes_linke + 15)) berlin_adjustment_r_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 15)) berlin_adjustment_r_factors.linke += 0.05;

if (Q.urban_spd > (Q.votes_spd + 3)) berlin_adjustment_r_factors.spd += 0.1;
if (Q.east_spd > (Q.votes_spd + 3)) berlin_adjustment_r_factors.spd += 0.1;
if (Q.urban_spd > (Q.votes_spd + 6)) berlin_adjustment_r_factors.spd += 0.1;
if (Q.east_spd > (Q.votes_spd + 6)) berlin_adjustment_r_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 6)) berlin_adjustment_r_factors.spd += 0.05;
if (Q.urban_spd > (Q.votes_spd + 15)) berlin_adjustment_r_factors.spd += 0.1;
if (Q.east_spd > (Q.votes_spd + 15)) berlin_adjustment_r_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 15)) berlin_adjustment_r_factors.spd += 0.05;

if (Q.urban_greens > (Q.votes_greens + 3)) berlin_adjustment_r_factors.greens += 0.1;
if (Q.east_greens > (Q.votes_greens + 3)) berlin_adjustment_r_factors.greens += 0.1;
if (Q.urban_greens > (Q.votes_greens + 6)) berlin_adjustment_r_factors.greens += 0.1;
if (Q.east_greens > (Q.votes_greens + 6)) berlin_adjustment_r_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 6)) berlin_adjustment_r_factors.greens += 0.05;
if (Q.urban_greens > (Q.votes_greens + 15)) berlin_adjustment_r_factors.greens += 0.1;
if (Q.east_greens > (Q.votes_greens + 15)) berlin_adjustment_r_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 15)) berlin_adjustment_r_factors.greens += 0.05;

if (Q.urban_fdp > (Q.votes_fdp + 3)) berlin_adjustment_r_factors.fdp += 0.1;
if (Q.east_fdp > (Q.votes_fdp + 3)) berlin_adjustment_r_factors.fdp += 0.1;
if (Q.urban_fdp > (Q.votes_fdp + 6)) berlin_adjustment_r_factors.fdp += 0.1;
if (Q.east_fdp > (Q.votes_fdp + 6)) berlin_adjustment_r_factors.fdp += 0.1;
if (Q.youth_fdp > (Q.votes_fdp + 6)) berlin_adjustment_r_factors.fdp += 0.05;
if (Q.urban_fdp > (Q.votes_fdp + 15)) berlin_adjustment_r_factors.fdp += 0.1;
if (Q.east_fdp > (Q.votes_fdp + 15)) berlin_adjustment_r_factors.fdp += 0.1;
if (Q.youth_fdp > (Q.votes_fdp + 15)) berlin_adjustment_r_factors.fdp += 0.05;

if (Q.urban_cdu > (Q.votes_cdu + 3)) berlin_adjustment_r_factors.cdu += 0.1;
if (Q.east_cdu > (Q.votes_cdu + 3)) berlin_adjustment_r_factors.cdu += 0.1;
if (Q.urban_cdu > (Q.votes_cdu + 6)) berlin_adjustment_r_factors.cdu += 0.1;
if (Q.east_cdu > (Q.votes_cdu + 6)) berlin_adjustment_r_factors.cdu += 0.1;
if (Q.youth_cdu > (Q.votes_cdu + 6)) berlin_adjustment_r_factors.cdu += 0.05;
if (Q.urban_cdu > (Q.votes_cdu + 15)) berlin_adjustment_r_factors.cdu += 0.1;
if (Q.east_cdu > (Q.votes_cdu + 15)) berlin_adjustment_r_factors.cdu += 0.1;
if (Q.youth_cdu > (Q.votes_cdu + 15)) berlin_adjustment_r_factors.cdu += 0.05;

if (Q.urban_afd > (Q.votes_afd + 3)) berlin_adjustment_r_factors.afd += 0.1;
if (Q.east_afd > (Q.votes_afd + 3)) berlin_adjustment_r_factors.afd += 0.1;
