if (Q.east_afd > (Q.votes_afd + 15)) berlin_adjustment_r_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 15)) berlin_adjustment_r_factors.afd += 0.05;


Q.spd_r_berlin = Q.spd_votes*berlin_adjustment_r_factors.spd;
Q.linke_r_berlin = Q.linke_votes*berlin_adjustment_r_factors.linke;
Q.fdp_r_berlin = Q.fdp_votes*berlin_adjustment_r_factors.fdp;
if (Q.issue_migration >= 5) berlin_adjustment_factors.afd += 0.2;
Q.afd_r_berlin = Q.afd_votes*berlin_adjustment_r_factors.afd;
Q.cdu_r_berlin = Q.cdu_votes*berlin_adjustment_r_factors.cdu;
if (Q.issue_environment >= 5) berlin_adjustment_r_factors.greens += 0.1;
Q.greens_r_berlin = Q.greens_votes*berlin_adjustment_r_factors.greens;
Q.bsw_r_berlin = Q.bsw_votes*berlin_adjustment_r_factors.bsw;

Q.total_r_berlin = 0;

if (Q.spd_r_berlin) Q.total_r_berlin += Q.spd_r_berlin;
if (Q.linke_r_berlin) Q.total_r_berlin += Q.linke_r_berlin;
if (Q.greens_r_berlin) Q.total_r_berlin += Q.greens_r_berlin;
if (Q.fdp_r_berlin) Q.total_r_berlin += Q.fdp_r_berlin;
if (Q.afd_r_berlin) Q.total_r_berlin += Q.afd_r_berlin;
if (Q.cdu_r_berlin) Q.total_r_berlin += Q.cdu_r_berlin;
if (Q.bsw_r_berlin) Q.total_r_berlin += Q.bsw_r_berlin;

if (Q.total_r_berlin > 0) {
    Q.spd_r_berlin = (Q.spd_r_berlin / Q.total_r_berlin) * 100;
    Q.linke_r_berlin = (Q.linke_r_berlin / Q.total_r_berlin) * 100;
    Q.greens_r_berlin = (Q.greens_r_berlin / Q.total_r_berlin) * 100;
    Q.fdp_r_berlin = (Q.fdp_r_berlin / Q.total_r_berlin) * 100;
    Q.afd_r_berlin = (Q.afd_r_berlin / Q.total_r_berlin) * 100;
    Q.cdu_r_berlin = (Q.cdu_r_berlin / Q.total_r_berlin) * 100;
    Q.bsw_r_berlin = (Q.bsw_r_berlin / Q.total_r_berlin) * 100;
}

function allocateSeats(percentages, totalSeats = 147) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_r_berlin: Q.spd_r_berlin,
    linke_r_berlin: Q.linke_r_berlin,
    greens_r_berlin: Q.greens_r_berlin,
    fdp_r_berlin: Q.fdp_r_berlin,
    afd_r_berlin: Q.afd_r_berlin,
    cdu_r_berlin: Q.cdu_r_berlin,
    bsw_r_berlin: Q.bsw_r_berlin,
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 147).toFixed(1));
}

///////////////////// potential coalition calculation /////////////////////////

Q.berlin_pot_groko = parseFloat((Q.spd_r_berlin + Q.cdu_r_berlin).toFixed(1));
Q.berlin_pot_traffic_light = parseFloat((Q.fdp_r_berlin + Q.spd_r_berlin + Q.greens_r_berlin).toFixed(1));
Q.berlin_pot_jamaica = parseFloat((Q.greens_r_berlin + Q.cdu_r_berlin + Q.fdp_r_berlin).toFixed(1));
Q.berlin_pot_rot_rot = parseFloat((Q.linke_r_berlin + Q.spd_r_berlin).toFixed(1));
Q.berlin_pot_tigerenten = parseFloat((Q.cdu_r_berlin + Q.fdp_r_berlin).toFixed(1));
Q.berlin_pot_kiwi = parseFloat((Q.cdu_r_berlin + Q.greens_r_berlin).toFixed(1));
Q.berlin_pot_tigerenten = parseFloat((Q.cdu_r_berlin + Q.fdp_r_berlin).toFixed(1));
Q.berlin_pot_die_linke_maj = parseFloat((Q.linke_r_berlin).toFixed(1));
Q.berlin_pot_die_linke_maj = parseFloat((Q.linke_r_berlin).toFixed(1));
Q.berlin_pot_afd_maj = parseFloat((Q.afd_r_berlin).toFixed(1));
Q.berlin_pot_rot_grun = parseFloat((Q.spd_r_berlin + Q.greens_r_berlin).toFixed(1));
Q.berlin_pot_rot_rot_grun = parseFloat((Q.spd_r_berlin + Q.greens_r_berlin + Q.linke_r_berlin).toFixed(1));
Q.berlin_pot_spd_maj = parseFloat((Q.spd_r_berlin).toFixed(1));
Q.berlin_pot_green_maj = parseFloat((Q.greens_r_berlin).toFixed(1));
Q.berlin_pot_cdu_maj = parseFloat((Q.cdu_r_berlin).toFixed(1));
Q.berlin_pot_weimar_but_different = parseFloat((Q.cdu_r_berlin + Q.fdp_r_berlin + Q.spd_r_berlin).toFixed(1));
Q.berlin_pot_kenya = parseFloat((Q.cdu_r_berlin + Q.greens_r_berlin + Q.spd_r_berlin).toFixed(1));
Q.berlin_pot_schwarz_blau = parseFloat((Q.cdu_r_berlin + Q.afd_r_berlin).toFixed(1));
Q.berlin_pot_red_purple = parseFloat((Q.bsw_r_berlin + Q.linke_r_berlin).toFixed(1));
Q.berlin_pot_brombeer = parseFloat((Q.bsw_r_berlin + Q.cdu_r_berlin + Q.spd_r_berlin).toFixed(1));
Q.berlin_pot_querfront = parseFloat((Q.bsw_r_berlin + Q.afd_r_berlin).toFixed(1));

Q.linke_berlin_elections_vote = (Q.linke_berlin_elections_vote != undefined ? parseFloat(Q.linke_berlin_elections_vote.toFixed(1)) : 0);
Q.spd_berlin_elections_vote = (Q.spd_berlin_elections_vote != undefined ? parseFloat(Q.spd_berlin_elections_vote.toFixed(1)) : 0);
Q.spd_r_berlin = (Q.spd_r_berlin != undefined ? parseFloat(Q.spd_r_berlin.toFixed(1)) : 0);

!}
on-display: {!
var data = [];

/////////////////////////////// push diagram data ////////////////////////////////////

if (Q.bsw_berlin_elections_vote >= 5) {
    data.push({
        "id": "bsw",
        "legend": "BSW",
        "name": "BSW",
        "seats": Math.round(Q.bsw_r_berlin * 1.47)
    });
}

if (Q.linke_berlin_elections_vote >= 5) {
    data.push({
        "id": "linke",
        "legend": "Left",
        "name": "Left",
        "seats": Math.round(Q.linke_r_berlin * 1.47)
    });
}

if (Q.spd_berlin_elections_vote >= 5) {
    data.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Math.round(Q.spd_r_berlin * 1.47)
    });
}

if (Q.greens_berlin_elections_vote >= 5) {
    data.push({
        "id": "greens",
        "legend": "B90/Greens",
        "name": "B90/Greens",
        "seats": Math.round(Q.greens_r_berlin * 1.47)
    });
}

if (Q.fdp_berlin_elections_vote >= 5) {
    data.push({
        "id": "fdp",
        "legend": "FDP",
        "name": "FDP",
        "seats": Math.round(Q.fdp_r_berlin * 1.47)
    });
}

if (Q.cdu_berlin_elections_vote >= 5) {
    data.push({
        "id": "cdu",
        "legend": "CDU",
        "name": "CDU",
        "seats": Math.round(Q.cdu_r_berlin * 1.47)
    });
}

if (Q.afd_berlin_elections_vote >= 5) {
    data.push({
        "id": "afd",
        "legend": "AfD",
        "name": "AfD",
        "seats": Math.round(Q.afd_r_berlin * 1.47)
    });
}
setTimeout(function() {
    if (window && window.d3) {
        var width = 500;
        var height = 500;
        var contentDiv = document.getElementById('content');

        if (!contentDiv) return; 

        var screenWidth = contentDiv.offsetWidth;
        if (screenWidth < width - 50) {
            width = screenWidth - 50;
            height = width;
            var svgElement = document.getElementById("berlin_landtag");
            if (svgElement) {
                svgElement.style.height = (screenWidth / 2) + "px";
            }
        }

        var parliament = d3.parliament();
        parliament.width(width).height(height).innerRadiusCoef(0.4);
        parliament.enter.fromCenter(true).smallToBig(true);
        parliament.exit.toCenter(false).bigToSmall(true);

        d3.select("#berlin_landtag").selectAll("*").remove();
        d3.select("#berlin_landtag").datum(data).call(parliament);
    }
}, 147);

!}

