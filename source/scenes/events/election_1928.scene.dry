title: Bundestag elections
new-page: true
tags: event
priority: -2
view-if: (year = next_election_year and month >= next_election_month and (next_election_week == week or not rubicon)) or (year > next_election_year)
on-arrival: election_boycott = 0
on-departure: in_election = 0; next_election_year = next_election_year + 4; n_elections += 1; next_election_time = time + 48
set-jump: post_election_1928
set-bg: img/map_2.jpg
#face-image: img/Rothe_Wahlen_1903.jpg


= Elections, [+ month : month +] [+ year +]

The Bundestag elections are to be held now.

- @election_algorithm: May we do our best...

@post_election_1928
on-arrival: {!  
    Q.pre_previous_cdu_last_election_votes = Q.previous_cdu_last_election_votes;
    Q.cdu_votes_pre = Q.cdu_votes;

    Q.adjustmentFactors_votes_linke = 1.0;
    Q.adjustmentFactors_votes_bsw = 1.0;
    Q.adjustmentFactors_votes_greens = 1.0;
    Q.adjustmentFactors_votes_spd = 1.0;
    Q.adjustmentFactors_votes_fdp = 1.0;
    Q.adjustmentFactors_votes_cdu = 1.0;
    Q.adjustmentFactors_votes_afd = 1.0;
    Q.adjustmentFactors_votes_other = 1.0;

    Q.adjustmentFactors_linke = 1.0;
    Q.adjustmentFactors_bsw = 1.0;
    Q.adjustmentFactors_greens = 1.0;
    Q.adjustmentFactors_spd = 1.0;
    Q.adjustmentFactors_fdp = 1.0;
    Q.adjustmentFactors_cdu = 1.0;
    Q.adjustmentFactors_afd = 1.0;
    Q.adjustmentFactors_other = 0.75;

    var new_party_sum = 0;
    var total_bundestag_without = 0;  // Initialize a variable to accumulate 'reichstag_without_' values
    var total_other_party_sum = 0;    // Initialize a variable to accumulate '_other_party_sum' values
//    if (Q.year === 1928 && Q.dnvp_leader === "Hugenberg" || Q.dnvp_westarp) {
//        Q.adjustmentFactors_other = 0.75;
//    } else if (Q.year === 1929 && Q.dnvp_leader === "Hugenberg") {
//        Q.adjustmentFactors_other = 0.85;
//    } else if (Q.year === 1930 && Q.dnvp_leader === "Hugenberg") {
//        Q.adjustmentFactors_other = 0.9;
//    } else if (Q.year === 1931 && Q.dnvp_leader === "Hugenberg") {
//        Q.adjustmentFactors_other = 0.8;
//    } else if (Q.year >= 1932 && Q.dnvp_leader === "Hugenberg") {
//        Q.adjustmentFactors_other = 0.6;
//    } else if (Q.year >= 1928 && Q.dnvp_leader === "Triumvirate") {
//        Q.adjustmentFactors_other = 0.75;
//    } else if (Q.year === 1928 && Q.dnvp_ideology === "Moderate") {
//        Q.adjustmentFactors_other = 0.65;
//    } else if (Q.year === 1929 && Q.dnvp_ideology === "Moderate") {
//        Q.adjustmentFactors_other = 0.7;
//    } else if (Q.year === 1930 && Q.dnvp_ideology === "Moderate") {
//        Q.adjustmentFactors_other = 0.75;
//    } else if (Q.year === 1931 && Q.dnvp_ideology === "Moderate") {
//        Q.adjustmentFactors_other = 0.7;
//    } else if (Q.year >= 1932 && Q.dnvp_ideology === "Moderate") {
//        Q.adjustmentFactors_other = 0.6;
//    }
//    if (Q.kvp_cnblp_sister) {
//        Q.adjustmentFactors_other += 0.05;
//    }
//    if (Q.bourgeois_parliament || Q.bourgeois_parliament_no_liberals) {
//        Q.adjustmentFactors_other += 0.05;
//    }
//    if (Q.other_votes >= 8 && Q.year >= 1931) {
//        Q.adjustmentFactors_other += 0.1;
//    }
//    if (Q.other_dnef) {
//        Q.adjustmentFactors_other = 0;
//    }
    if (Q.cvp_formed) Q.adjustmentFactors_other = 0.6;
    if (Q.aspd_other) Q.adjustmentFactors_other += 0.4;
    Q.adjustmentFactors_ddp = 1.0;
    if (!Q.bourgeois_list_ddp && !Q.dstp_dnef) {
        if (Q.ddp_votes < 1 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.3;
        } else if (Q.ddp_votes < 1.5 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.65;
        } else if (Q.ddp_votes < 3 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.75;
        } else if (Q.ddp_votes < 4 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.85;
        }
    }
    if (Q.ddp_alliance) Q.adjustmentFactors_ddp = 0.8;
    if (Q.ddp_alliance_glaze) Q.adjustmentFactors_ddp = 1.1;
    Q.adjustmentFactors_dvp = 1.0;
    if (!Q.hugenberg_dvp && !Q.bourgeois_list && !Q.dvp_dnef) {
        if (Q.dvp_votes < 1.5) {
            Q.adjustmentFactors_dvp = 0.25;
        } else if (Q.dvp_votes < 2) {
            Q.adjustmentFactors_dvp = 0.4;
        } else if (Q.dvp_votes < 2.5) {
            Q.adjustmentFactors_dvp = 0.6;            
        } else if (Q.dvp_votes < 3) {
            Q.adjustmentFactors_dvp = 0.8;   
        }
    }
    if (Q.hugenberg_dvp) Q.adjustmentFactors_dvp = 1.0;

    let total_adjusted_votes = 0;
    for (var party of Q.parties) {
        let factor = Q['adjustmentFactors_votes_' + party] || 1.0;
        Q['original_' + party + '_votes'] = Q[party + '_votes'];
        Q[party + '_votes'] = Q[party + '_votes'] * factor;
        total_adjusted_votes += Q[party + '_votes'];
    }

    let normalization_factor = 100 / total_adjusted_votes;
    Q.boycott_effect = normalization_factor;
    for (var party of Q.parties) {
        Q[party + '_votes'] = Math.round(Q[party + '_votes'] * normalization_factor * 10) / 10;
    }
    // Step 1: Calculate adjusted values and the sum for redistribution
    for (var party of Q.parties) {
        let factor = Q['adjustmentFactors_' + party] || 1.0; // Default to 1.0 if not set
        
        Q['old_' + party + '_b'] = Q[party + '_b']; // Store the original b value for comparison
        
        // Handle constitutional reform logic: set the party's share to 0 based on conditions
        if ((Q.constitutional_reform > 0 &&
             (Q[party + '_votes'] < Q.electoral_threshold || 
             (Q.electoral_threshold > 1 && party === 'other'))) 
            || Q[party + '_banned']) {
            Q[party + '_b'] = 0;
        } else {
            // Adjust `b` based on the adjustment factor if not affected by constitutional reform
            Q['original_' + party + '_b'] = Math.round(Q[party + '_votes'] * 10) / 10;
            Q[party + '_b'] = Math.round(Q[party + '_votes'] * factor * 10) / 10;
        }
        
        if (Q[party + '_b'] > 0) {
            if (factor !== 1.0) { // Only apply to parties with adjustment factors
                // Calculate the Reichstag without the current party's share
                Q['bundestag_without_' + party] = 100 - Q['original_' + party + '_b'];
                total_bundestag_without += Q['bundestag_without_' + party]; // Accumulate the total of 'bundestag_without_' values

                // Calculate the sum of the remaining parties
                Q[party + '_other_party_sum'] = Q['bundestag_without_' + party] - (Q[party + '_votes'] - Q[party + '_b']);
                total_other_party_sum += Q[party + '_other_party_sum']; // Accumulate the total of '_other_party_sum' values
            } else {
                // For non-adjusted parties, accumulate their r value for the redistribution
                new_party_sum += Q[party + '_b'];
            }
        }
    }
    
console.log(Q.linke_b)

// Step 2: Redistribute results among non-adjusted parties to ensure the total is 100%
if (new_party_sum > 0) {
    for (var party of Q.parties) {
        let factor = Q['adjustmentFactors_' + party] || 1.0;

        if (Q[party + '_b'] === 0) continue;

        var total_reichstag_without_party = total_bundestag_without - (100 - Q['original_' + party + '_b']);
        var total_other_party_sum_party = total_other_party_sum - (Q['bundestag_without_' + party] - (Q[party + '_votes'] - Q[party + '_b']));

        console.log(Q.linke_b)

        if (factor === 1.0) {
            if (total_other_party_sum > 0) {
                Q[party + '_b'] = Math.round((Q[party + '_b'] * total_reichstag_without) / total_other_party_sum * 10) / 10;
            } else {
                Q[party + '_b'] = Q[party + '_b'];
            }
        } else if (factor !== 1.0 && total_bundestag_without_party > 0 && total_other_party_sum_party > 0) {
            let scaling_factor = total_reichstag_without_party / total_other_party_sum_party;
            Q[party + '_b'] = Math.round(Q[party + '_b'] * scaling_factor * 10) / 10;
        }
    }

    console.log(Q.linke_b)

    // Step 3: Normalize to ensure the total sums to exactly 100%
    let total_b_sum = 0;

    // Calculate the total of all `r` values after redistribution
    for (var party of Q.parties) {
        total_r_sum += Q[party + '_b'];
    }

    // Adjust each party's `r` value proportionally if the total isn't 100
    if (total_r_sum !== 100) {
        let normalization_factor = 100 / total_r_sum;
        for (var party of Q.parties) {
            if (Q[party + '_b'] > 0) {
                Q[party + '_b'] = Math.round(Q[party + '_b'] * normalization_factor * 10) / 10;
            }
        }
    }
    console.log(Q.linke_b)
}
    // Step 3: Calculate changes in results
    for (var party of Q.parties) {
        Q['change_' + party + '_b'] = Q[party + '_b'] - Q['old_' + party + '_b'];
        var sign = Q['change_' + party + '_b'] > 0 
                   ? '<img src="img/arrowup.png"> ' 
                   : Q['change_' + party + '_b'] < 0 
                     ? '<img src="img/arrowdown.png"> ' 
                     : '<img src="img/steady.png"> ';
        Q['change_' + party + '_b'] = Math.abs(Q['change_' + party + '_b']);
        Q['str_change_' + party] = sign + parseFloat(Q['change_' + party + '_b']).toFixed(1);
    
        // Calculate changes in votes
        Q['change_' + party + '_votes'] = Q[party + '_votes'] - Q['previous_' + party + '_last_election_votes'];
        if (Q['previous_' + party + '_last_election_votes'] === undefined) {
            Q['change_' + party + '_votes'] = Q[party + '_votes'];
        }
        var sign2 = Q['change_' + party + '_votes'] > 0 
                    ? '<img src="img/arrowup.png"> ' 
                    : Q['change_' + party + '_votes'] < 0 
                      ? '<img src="img/arrowdown.png"> ' 
                      : '<img src="img/steady.png"> ';
        Q['str_votes_change_' + party] = sign2 + Math.abs(Q['change_' + party + '_votes']).toFixed(1);
    }
    
    // Handle demographic changes for all parties
    for (var party of Q.parties) {
        for (var c of Q.classes) {
            Q[c + "_change_" + party + '_display'] = Q[c + '_' + party + '_display'] - Q['old_' + c + '_' + party + '_display'];
            var sign3 = Q[c + "_change_" + party + '_display'] > 0 ? '+' : '';
            Q['demo_change_' + c + '_' + party + '_display'] = sign3 + parseFloat(Q[c + "_change_" + party + '_display']).toFixed(0);
            Q['old_' + c + '_' + party + '_display'] = Q[c + '_' + party + '_display'];
        }
    }
    
    // Store current votes as previous for the next iteration
    for (var party of Q.parties) {
        Q[party + '_last_election_votes'] = parseFloat(Q[party + '_votes']).toFixed(1);
        Q['previous_' + party + '_last_election_votes'] = parseFloat(parseFloat(Q[party + '_last_election_votes']).toFixed(1));
    }    
    
Q.csu_votes = Q.cdu_votes*0.25;
Q.csu_b = Q.csu_votes*1.05;

if (!Q.z_dnef) Q.csu_b = parseFloat(Q.csu_b.toFixed(1));
Q.csu_votes = parseFloat(Q.csu_votes.toFixed(1));

Q.cdu_minus_csu_votes = parseFloat((Q.cdu_votes - Q.csu_votes).toFixed(1));
Q.cdu_minus_csu_b = parseFloat((Q.cdu_b - Q.csu_b).toFixed(1));

console.log("cdu_minus_csu_votes:", Q.cdu_minus_csu_votes);
console.log("pre_previous_cdu_last_election_votes:", Q.pre_previous_cdu_last_election_votes);

Q.str_votes_change_csu = Q.csu_votes - Q.previous_csu_last_election_votes;
var sign2 = Q.str_votes_change_csu > 0 
? '<img src="img/arrowup.png"> ' 
: Q.str_votes_change_csu < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.str_votes_change_csu = sign2 + Math.abs(Q.str_votes_change_bvp).toFixed(1);

Q.str_change_csu = Q.csu_b - Q.old_csu_b;
var sign2 = Q.str_change_csu > 0 
? '<img src="img/arrowup.png"> ' 
: Q.str_change_bvp < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.str_change_csu = sign2 + Math.abs(Q.str_change_bvp).toFixed(1);

if (Q.csu_b) {
    Q.pre_previous_cdu_last_election_votes -= Q.previous_csu_last_election_votes;
    Q.old_cdu_b -= Q.old_csu_b;
}
Q.previous_csu_last_election_votes = Q.csu_votes;
Q.old_csu_b = Q.bvp_b;

console.log("cdu_minus_csu_votes:", Q.cdu_minus_csu_votes);
console.log("pre_previous_cdu_last_election_votes:", Q.pre_previous_cdu_last_election_votes);

Q.str_votes_change_cdu = Q.cdu_minus_csu_votes - Q.pre_previous_cdu_last_election_votes;
var sign2 = Q.str_votes_change_cdu > 0 
? '<img src="img/arrowup.png"> ' 
: Q.str_votes_change_cdu < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.str_votes_change_cdu = sign2 + Math.abs(Q.str_votes_change_cdu).toFixed(1);

if (pragmatist_strength <= 40 or oldleft_strength >= 45 or beweli_strength >= 45) {
    if (Q.linke_votes >= 35) {
        Q.greens_relation -= 12;
        Q.spd_relation -= 12;
        Q.cdu_relation -= 12;
    } else if (Q.linke_votes >= 25) {
        Q.spd_relation -= 9;
        Q.greens_relation -= 9;
        Q.cdu_relation -= 9;
    } else if (Q.linke_votes >= 20) {
        Q.spd_relation -= 6;
        Q.greens_relation -= 6;
        Q.cdu_relation -= 6;
    }
}

Q.last_election_time = Q.time;



Q.largest_party = 'CDU';
if (Q.spd_b >= Q.cdu_b && Q.spd_b >= Q.linke_b && Q.spd_b >= Q.afd_b) {
    Q.largest_party = 'SPD';
} else if (Q.linke_b >= Q.cdu_b && Q.linke_b >= Q.spd_b && Q.linke_b >= Q.afd_b) {
    Q.largest_party = 'LINKE';
} else if (Q.afd_b >= Q.cdu_b && Q.afd_b >= Q.spd_b && Q.afd_b >= Q.linke_b) {
    Q.largest_party = 'AfD';
}

// coalitions

Q.rrgreen_coalition = parseFloat((Q.linke_b + Q.spd_b + greens_b).toFixed(1));
Q.ampelkoalition_coalition = parseFloat((Q.spd_b + Q.greens_b + Q.fdp_b).toFixed(1));


Q.leverage = Q.linke_b;
// if (Q.right_coalition >= 50 && (Q.dnvp_ideology == "Moderate" || Q.dnvp_westarp) || Q.center_right_coalition >= 50 && Q.dnvp_ideology == "Moderate") Q.leverage -= 5;


Q.coalition_dissent = 0;

Q.linke_toleration = 0;
Q.linke_in_government = 0;
Q.spd_in_government = 0;
Q.greens_in_government = 0;
Q.bsw_in_government = 0;
Q.cdu_in_government = 0;
Q.afd_in_government = 0;
Q.fdp_in_government = 0;
Q.in_rrgreen_coalition = 0;
Q.ampelkoalition = 0;
Q.in_left_front = 0;
Q.in_linke_majority = 0;

if (Q.year < 2025) {
    Q.bundestag_size = 7.36;
} else {
    Q.bundestag_size = 6.3;
}

var election_result = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties_graph) {
    election_result[party] = Q[party + '_b'];
}
Q.election_records.push(election_result);
!}
on-departure: nazi_urgency = 1 if (nazi_urgency == 0 and nsdap_r >= 15)
on-display: {!
const data = [];

if (Q.bsw_b) {
    data.push({
        "id": "bsw",
        "legend": "BSW",
        "name": "BSW",
        "seats": Math.round(Q.bsw_b * Q.bundestag_size),
    });
}

if (Q.linke_b) {
    data.push({
        "id": "linke",
        "legend": "Left",
        "name": "Left",
        "seats": Math.round(Q.linke_b * Q.bundestag_size),
    });
}

if (Q.greens_b) {
    data.push({
        "id": "greens",
        "legend": "B90/Greens",
        "name": "B90/Greens",
        "seats": Math.round(Q.greens_b * Q.bundestag_size),
    });
}

if (Q.spd_b) {
    data.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Math.round(Q.spd_b * Q.bundestag_size),
    });
}

if (Q.fdp_b) {
    data.push({
        "id": "fdp",
        "legend": "FDP",
        "name": "FDP",
        "seats": Math.round(Q.fdp_b * Q.bundestag_size),
    });
}

if (Q.cdu_minus_csu_b) {
    data.push({
        "id": "cdu",
        "legend": "CDU",
        "name": "CDU",
        "seats": Math.round(Q.cdu_minus_csu_b * Q.bundestag_size),
    });
}

if (Q.csu_b) {
    data.push({
        "id": "csu",
        "legend": "CSU",
        "name": "CSU",
        "seats": Math.round(Q.csu_b * Q.bundestag_size),
    });
}

if (Q.afd_b) {
    data.push({
        "id": "afd",
        "legend": "AfD",
        "name": "AfD",
        "seats": Math.round(Q.afd_b * Q.bundestag_size),
    });
}

if (Q.year >= 2023) {
    data.push({
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(1),
    });
}



if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);

    var lines = d3.linegraph(false, false,
            Q.parties_graph,
            {'linke': '#E3000F', 'greens': '#700000', 'spd': '#D3C24D', 'cdu': '#000', 'fdp': '#D5AC27', 'afd': '#3E88B3', 'other': '#a0a0a0', 'bsw': '#9B0000'},
            {'linke': 'Left', 'greens': 'B90/Greens', 'spd': 'SPD', 'cdu': 'CDU', 'afd': 'AfD', 'other': 'Others', 'bsw': 'BSW', 'fdp': 'FDP'});
    lines.width(width).height(400);
    //var svg = lines(Q.election_records);
    d3.select("#election_history").datum(Q.election_records).call(lines);
    //document.getElementById('election_history').innerHTML = svg.outerHTML;

    // party support records should not have so many ticks
    if (!Q.historical_mode) {
        var lines_2 = d3.linegraph(true, true,
            Q.parties_graph,
            {'linke': '#E3000F', 'greens': '#700000', 'spd': '#D3C24D', 'cdu': '#000', 'fdp': '#D5AC27', 'afd': '#3E88B3', 'other': '#a0a0a0', 'bsw': '#9B0000'},
            {'linke': 'Left', 'greens': 'B90/Greens', 'spd': 'SPD', 'cdu': 'CDU', 'afd': 'AfD', 'other': 'Others', 'bsw': 'BSW', 'fdp': 'FDP'});
    lines_2.width(width).height(400);
        d3.select("#party_support_history").datum(Q.party_support_records).call(lines_2);
    }
}
!}
go-to: achievement_check_e

= Election results

{!<svg id="bundestag" style="width: 500px; height: 250px;"> </svg>!}
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td><td>Reichstag Seats</td><td>% Change</td></tr>!}

{!<tr><td><div class="box" style='background-color:#700000'> </div> !}Left: {!</td><td>!} [+ linke_votes +]% {!</td><td>!} [+ str_votes_change_linke +] {!</td><td>!} [+ linke_b +]% {!</td><td>!} [+ str_change_linke +] {!</td></tr>!}

//[? if not z_dnef: {!<tr><td><div class="box" style='background-color:#000'> </div> !} [+ z_party_name +]: {!</td><td>!} [+ z_minus_bvp_votes +]% {!</td><td>!} [+ str_votes_change_z +] {!</td><td>!} [+ z_minus_bvp_r +]% {!</td><td>!} [+ str_change_z +] {!</td></tr>!} ?]

//[? if not z_dnef: {!<tr><td><div class="box" style='background-color:#A2D8E0'> </div> !} BVP: {!</td><td>!} [+ bvp_votes +]% {!</td><td>!} [+ str_votes_change_bvp +] {!</td><td>!} [+ bvp_r +]% {!</td><td>!} [+ str_change_bvp +] {!</td></tr>!} ?]

{!</table>!}

{!<button class="tab_button" id="demographics_tab" onclick="window.toggleDem();">Demographic Results</button>!}
{!<button class="tab_button" id="election_tab" onclick="window.toggleElectionGraph();">Previous Elections Graph</button>!}
{!<button class="tab_button" id="graph_tab" onclick="window.toggleGraph();">Party Support Graph</button>!}

{!<div id="results" style="display: none;">!}
    {!<div style="overflow-x:auto;">!}
    {!<table style="text-align:center; border-spacing: 0.2em;">!}
        {!<tr>!}
            {!<th>Party</th>!}
            {!<th>Youth</th>!}
            {!<th>Urban</th>!}
            {!<th>Rural</th>!}
            {!<th>Upper</th>!}
            {!<th>East</th>!}
        {!</tr>!}
        {!<tr>!}
            {!<td><span style="color: #c00000;"><b>Left</b></span></td>!}
            {!<td style="background-color: rgba(192, 0, 0, 0.1); font-size: 0.85em; padding: 10px">!}[+ youth_linke_display +]%[? if n_elections != 1 and demo_change_youth_linke_display != 0 : ([+ demo_change_youth_linke_display +])?]{!</td>!}
