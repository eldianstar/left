title: Bavarian state election
subtitle: The people of Bavaria head to the polls..
view-if: (year = next_election_year_bavaria and month >= next_election_month_bavaria) or (year > next_election_year_bavaria)
new-page: true
tags: event
on-arrival: bavaria_election_seen += 1; bavaria_election_seen_time = time; bavaria_most_recent = time;
on-departure: {! 
Q.next_election_year_bavaria = Q.next_election_year_bavaria + 4; 
Q.n_elections_bavaria += 1;
Q.next_election_time_bavaria = Q.time + 48;
!}
priority: 2
face-image: img/bavaria.png

= Bavarian state election, [+ month : month +] [+ year +]

The regularly scheduled elections for the Bavarian Landtag are to take place. The incumbent government is a [? if bavaria_groko = 1 : <span style="color: [+ csu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span> ?][? if bavaria_traffic_light = 1 : <span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ fw_color +];">Yellow</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if bavaria_rot_rot_grun = 1 : <span style="color: [+ linke_color +];">Red</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if bavaria_jamaica = 1 : <span style="color: [+ csu_color +];">Black</span>-<span style="color: [+ fw_color +];">Yellow</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if bavaria_rot_rot = 1 : <span style="color: [+ linke_color +];">Red</span>-<span style="color: [+ spd_color +];">Red</span> ?][? if bavaria_kenya = 1 : <span style="color: [+ csu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if bavaria_schwarz_blau = 1 : <span style="color: [+ csu_color +];">Black</span>-<span style="color: [+ afd_color +];">Blue</span> ?][? if bavaria_tigerenten = 1 : <span style="color: [+ csu_color +];">Black</span>-<span style="color: [+ fw_color +];">Orange</span> ?][? if bavaria_kiwi = 1 : <span style="color: [+ greens_color +];">Green</span>-<span style="color: [+ csu_color +];">Black</span> ?][? if bavaria_die_linke_maj = 1 : <span style="color: [+ linke_color +];">Red</span> ?][? if bavaria_afd_maj = 1 : <span style="color: [+ afd_color +];">Blue</span> ?][? if bavaria_rot_grun = 1 : <span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if bavaria_spd_maj = 1 : <span style="color: [+ spd_color +];">Red</span> ?][? if bavaria_green_maj = 1 : <span style="color: [+ greens_color +];">Green</span> ?][? if bavaria_csu_maj = 1 : <span style="color: [+ csu_color +];">Black</span> ?][? if bavaria_weimar_but_different = 1 : <span style="color: [+ csu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ fw_color +];">Yellow</span> ?] government.

- @bavaria: May we do our best...

@bavaria
on-arrival: {!

var bavaria_adjustment_factors = {
    spd: 0.50,
    linke: 0.35,
    fw: 1.55,
    csu: 1.65,
    afd: 0.80,
    greens: 1.0,
    bsw: 0.4,
};

Q.spd_r_bavaria = 0;
Q.linke_r_bavaria = 0;
Q.csu_r_bavaria = 0;
Q.greens_r_bavaria = 0;
Q.afd_r_bavaria = 0;
Q.fw_r_bavaria = 0;
Q.bsw_r_bavaria = 0;

Q.spd_bavaria_elections_vote = 0;
Q.linke_bavaria_elections_vote = 0;
Q.fw_bavaria_elections_vote = 0;
Q.afd_bavaria_elections_vote = 0;
Q.greens_bavaria_elections_vote = 0;
Q.csu_bavaria_elections_vote = 0;
Q.bsw_bavaria_elections_vote = 0;

///////////////////// class-based proportions votes ////////////////////////////////

if (Q.upper_linke > (Q.votes_linke + 3)) bavaria_adjustment_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 3)) bavaria_adjustment_factors.linke += 0.1;
if (Q.upper_linke > (Q.votes_linke + 6)) bavaria_adjustment_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 6)) bavaria_adjustment_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 6)) bavaria_adjustment_factors.linke += 0.05;
if (Q.upper_linke > (Q.votes_linke + 15)) bavaria_adjustment_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 15)) bavaria_adjustment_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 15)) bavaria_adjustment_factors.linke += 0.05;

if (Q.upper_spd > (Q.votes_spd + 3)) bavaria_adjustment_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 3)) bavaria_adjustment_factors.spd += 0.1;
if (Q.upper_spd > (Q.votes_spd + 6)) bavaria_adjustment_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 6)) bavaria_adjustment_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 6)) bavaria_adjustment_factors.spd += 0.05;
if (Q.upper_spd > (Q.votes_spd + 15)) bavaria_adjustment_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 15)) bavaria_adjustment_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 15)) bavaria_adjustment_factors.spd += 0.05;

if (Q.upper_greens > (Q.votes_greens + 3)) bavaria_adjustment_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 3)) bavaria_adjustment_factors.greens += 0.1;
if (Q.upper_greens > (Q.votes_greens + 6)) bavaria_adjustment_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 6)) bavaria_adjustment_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 6)) bavaria_adjustment_factors.greens += 0.05;
if (Q.upper_greens > (Q.votes_greens + 15)) bavaria_adjustment_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 15)) bavaria_adjustment_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 15)) bavaria_adjustment_factors.greens += 0.05;

if (Q.upper_fw > (Q.votes_fw + 3)) bavaria_adjustment_factors.fw += 0.1;
if (Q.rural_fw > (Q.votes_fw + 3)) bavaria_adjustment_factors.fw += 0.1;
if (Q.upper_fw > (Q.votes_fw + 6)) bavaria_adjustment_factors.fw += 0.1;
if (Q.rural_fw > (Q.votes_fw + 6)) bavaria_adjustment_factors.fw += 0.1;
if (Q.youth_fw > (Q.votes_fw + 6)) bavaria_adjustment_factors.fw += 0.05;
if (Q.upper_fw > (Q.votes_fw + 15)) bavaria_adjustment_factors.fw += 0.1;
if (Q.rural_fw > (Q.votes_fw + 15)) bavaria_adjustment_factors.fw += 0.1;
if (Q.youth_fw > (Q.votes_fw + 15)) bavaria_adjustment_factors.fw += 0.05;

if (Q.upper_csu > (Q.votes_csu + 3)) bavaria_adjustment_factors.csu += 0.1;
if (Q.rural_csu > (Q.votes_csu + 3)) bavaria_adjustment_factors.csu += 0.1;
if (Q.upper_csu > (Q.votes_csu + 6)) bavaria_adjustment_factors.csu += 0.1;
if (Q.rural_csu > (Q.votes_csu + 6)) bavaria_adjustment_factors.csu += 0.1;
if (Q.youth_csu > (Q.votes_csu + 6)) bavaria_adjustment_factors.csu += 0.05;
if (Q.upper_csu > (Q.votes_csu + 15)) bavaria_adjustment_factors.csu += 0.1;
if (Q.rural_csu > (Q.votes_csu + 15)) bavaria_adjustment_factors.csu += 0.1;
if (Q.youth_csu > (Q.votes_csu + 15)) bavaria_adjustment_factors.csu += 0.05;

if (Q.upper_afd > (Q.votes_afd + 3)) bavaria_adjustment_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 3)) bavaria_adjustment_factors.afd += 0.1;
if (Q.upper_afd > (Q.votes_afd + 6)) bavaria_adjustment_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 6)) bavaria_adjustment_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 6)) bavaria_adjustment_factors.afd += 0.05;
if (Q.upper_afd > (Q.votes_afd + 15)) bavaria_adjustment_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 15)) bavaria_adjustment_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 15)) bavaria_adjustment_factors.afd += 0.05;

////////////////// calculate seats votes ///////////////////////////////

Q.spd_bavaria_elections_vote = Q.spd_votes*bavaria_adjustment_factors.spd;
Q.linke_bavaria_elections_vote = Q.linke_votes*bavaria_adjustment_factors.linke;
Q.fw_bavaria_elections_vote = Q.fw_votes*bavaria_adjustment_factors.fw;
if (Q.issue_migration >= 5) bavaria_adjustment_factors.afd += 0.2;
Q.afd_bavaria_elections_vote = Q.afd_votes*bavaria_adjustment_factors.afd;
Q.csu_bavaria_elections_vote = Q.csu_votes*bavaria_adjustment_factors.csu;
if (Q.issue_environment >= 5) bavaria_adjustment_factors.greens += 0.1;
Q.greens_bavaria_elections_vote = Q.greens_votes*bavaria_adjustment_factors.greens;
Q.bsw_bavaria_elections_vote = Q.bsw_votes*bavaria_adjustment_factors.bsw;

Q.total_votes_bavaria = Q.spd_bavaria_elections_vote + Q.linke_bavaria_elections_vote + Q.greens_bavaria_elections_vote + Q.fw_bavaria_elections_vote + Q.csu_bavaria_elections_vote + Q.afd_bavaria_elections_vote + Q.bsw_bavaria_elections_vote;

if (Q.total_votes_bavaria > 0) {
    Q.spd_bavaria_elections_vote = (Q.spd_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.linke_bavaria_elections_vote = (Q.linke_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.greens_bavaria_elections_vote = (Q.greens_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.fw_bavaria_elections_vote = (Q.fw_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.afd_bavaria_elections_vote = (Q.afd_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.csu_bavaria_elections_vote = (Q.csu_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.bsw_bavaria_elections_vote = (Q.bsw_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    let target = 2;
    Q.linke_bavaria_elections_vote = Math.round((Q.linke_bavaria_elections_vote + (target - Q.linke_bavaria_elections_vote) * 0.35) * 10) / 10;
    Q.total_votes_bavaria = Q.spd_bavaria_elections_vote + Q.linke_bavaria_elections_vote + Q.greens_bavaria_elections_vote + Q.fw_bavaria_elections_vote + Q.afd_bavaria_elections_vote + Q.csu_bavaria_elections_vote;
    Q.spd_bavaria_elections_vote = (Q.spd_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.linke_bavaria_elections_vote = (Q.linke_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.greens_bavaria_elections_vote = (Q.greens_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.fw_bavaria_elections_vote = (Q.fw_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.afd_bavaria_elections_vote = (Q.afd_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.csu_bavaria_elections_vote = (Q.csu_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.bsw_bavaria_elections_vote = (Q.bsw_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
}

Q.spd_bavaria_elections_vote = (Q.spd_bavaria_elections_vote != undefined ? parseFloat(Q.spd_bavaria_elections_vote.toFixed(1)) : 0);
Q.linke_bavaria_elections_vote = (Q.linke_bavaria_elections_vote != undefined ? parseFloat(Q.linke_bavaria_elections_vote.toFixed(1)) : 0);
Q.greens_bavaria_elections_vote = (Q.greens_bavaria_elections_vote != undefined ? parseFloat(Q.greens_bavaria_elections_vote.toFixed(1)) : 0);
Q.fw_bavaria_elections_vote = (Q.fw_bavaria_elections_vote != undefined ? parseFloat(Q.fw_bavaria_elections_vote.toFixed(1)) : 0);
Q.afd_bavaria_elections_vote = (Q.afd_bavaria_elections_vote != undefined ? parseFloat(Q.afd_bavaria_elections_vote.toFixed(1)) : 0);
Q.csu_bavaria_elections_vote = (Q.csu_bavaria_elections_vote != undefined ? parseFloat(Q.csu_bavaria_elections_vote.toFixed(1)) : 0);
Q.bsw_bavaria_elections_vote = (Q.bsw_bavaria_elections_vote != undefined ? parseFloat(Q.bsw_bavaria_elections_vote.toFixed(1)) : 0);

/////////////////////////// adj factors seats ////////////////////////////

var bavaria_adjustment_r_factors = {
    spd: 0.50,
    linke: 0.35,
    fw: 1.55,
    csu: 1.65,
    afd: 0.80,
    greens: 1.0,
    bsw: 0.4,
};

//////////////////////////// class based seats ///////////////////////////////

if (Q.upper_linke > (Q.votes_linke + 3)) bavaria_adjustment_r_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 3)) bavaria_adjustment_r_factors.linke += 0.1;
if (Q.upper_linke > (Q.votes_linke + 6)) bavaria_adjustment_r_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 6)) bavaria_adjustment_r_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 6)) bavaria_adjustment_r_factors.linke += 0.05;
if (Q.upper_linke > (Q.votes_linke + 15)) bavaria_adjustment_r_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 15)) bavaria_adjustment_r_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 15)) bavaria_adjustment_r_factors.linke += 0.05;

if (Q.upper_spd > (Q.votes_spd + 3)) bavaria_adjustment_r_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 3)) bavaria_adjustment_r_factors.spd += 0.1;
if (Q.upper_spd > (Q.votes_spd + 6)) bavaria_adjustment_r_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 6)) bavaria_adjustment_r_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 6)) bavaria_adjustment_r_factors.spd += 0.05;
if (Q.upper_spd > (Q.votes_spd + 15)) bavaria_adjustment_r_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 15)) bavaria_adjustment_r_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 15)) bavaria_adjustment_r_factors.spd += 0.05;

if (Q.upper_greens > (Q.votes_greens + 3)) bavaria_adjustment_r_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 3)) bavaria_adjustment_r_factors.greens += 0.1;
if (Q.upper_greens > (Q.votes_greens + 6)) bavaria_adjustment_r_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 6)) bavaria_adjustment_r_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 6)) bavaria_adjustment_r_factors.greens += 0.05;
if (Q.upper_greens > (Q.votes_greens + 15)) bavaria_adjustment_r_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 15)) bavaria_adjustment_r_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 15)) bavaria_adjustment_r_factors.greens += 0.05;

if (Q.upper_fw > (Q.votes_fw + 3)) bavaria_adjustment_r_factors.fw += 0.1;
if (Q.rural_fw > (Q.votes_fw + 3)) bavaria_adjustment_r_factors.fw += 0.1;
if (Q.upper_fw > (Q.votes_fw + 6)) bavaria_adjustment_r_factors.fw += 0.1;
if (Q.rural_fw > (Q.votes_fw + 6)) bavaria_adjustment_r_factors.fw += 0.1;
if (Q.youth_fw > (Q.votes_fw + 6)) bavaria_adjustment_r_factors.fw += 0.05;
if (Q.upper_fw > (Q.votes_fw + 15)) bavaria_adjustment_r_factors.fw += 0.1;
if (Q.rural_fw > (Q.votes_fw + 15)) bavaria_adjustment_r_factors.fw += 0.1;
if (Q.youth_fw > (Q.votes_fw + 15)) bavaria_adjustment_r_factors.fw += 0.05;

if (Q.upper_csu > (Q.votes_csu + 3)) bavaria_adjustment_r_factors.csu += 0.1;
if (Q.rural_csu > (Q.votes_csu + 3)) bavaria_adjustment_r_factors.csu += 0.1;
if (Q.upper_csu > (Q.votes_csu + 6)) bavaria_adjustment_r_factors.csu += 0.1;
if (Q.rural_csu > (Q.votes_csu + 6)) bavaria_adjustment_r_factors.csu += 0.1;
if (Q.youth_csu > (Q.votes_csu + 6)) bavaria_adjustment_r_factors.csu += 0.05;
if (Q.upper_csu > (Q.votes_csu + 15)) bavaria_adjustment_r_factors.csu += 0.1;
if (Q.rural_csu > (Q.votes_csu + 15)) bavaria_adjustment_r_factors.csu += 0.1;
if (Q.youth_csu > (Q.votes_csu + 15)) bavaria_adjustment_r_factors.csu += 0.05;

if (Q.upper_afd > (Q.votes_afd + 3)) bavaria_adjustment_r_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 3)) bavaria_adjustment_r_factors.afd += 0.1;
if (Q.upper_afd > (Q.votes_afd + 6)) bavaria_adjustment_r_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 6)) bavaria_adjustment_r_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 6)) bavaria_adjustment_r_factors.afd += 0.05;
if (Q.upper_afd > (Q.votes_afd + 15)) bavaria_adjustment_r_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 15)) bavaria_adjustment_r_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 15)) bavaria_adjustment_r_factors.afd += 0.05;


Q.spd_r_bavaria = Q.spd_votes*bavaria_adjustment_r_factors.spd;
Q.linke_r_bavaria = Q.linke_votes*bavaria_adjustment_r_factors.linke;
Q.fw_r_bavaria = Q.fw_votes*bavaria_adjustment_r_factors.fw;
if (Q.issue_migration >= 5) bavaria_adjustment_factors.afd += 0.2;
Q.afd_r_bavaria = Q.afd_votes*bavaria_adjustment_r_factors.afd;
Q.csu_r_bavaria = Q.csu_votes*bavaria_adjustment_r_factors.csu;
if (Q.issue_environment >= 5) bavaria_adjustment_r_factors.greens += 0.1;
Q.greens_r_bavaria = Q.greens_votes*bavaria_adjustment_r_factors.greens;
Q.bsw_r_bavaria = Q.bsw_votes*bavaria_adjustment_r_factors.bsw;

if (Q.spd_bavaria_elections_vote < 5) Q.spd_r_bavaria = 0;
if (Q.linke_bavaria_elections_vote < 5) Q.linke_r_bavaria = 0;
if (Q.greens_bavaria_elections_vote < 5) Q.greens_r_bavaria = 0;
if (Q.fw_bavaria_elections_vote < 5) Q.fw_r_bavaria = 0;
if (Q.afd_bavaria_elections_vote < 5) Q.afd_r_bavaria = 0;
if (Q.csu_bavaria_elections_vote < 5) Q.csu_r_bavaria = 0;
if (Q.bsw_bavaria_elections_vote < 5) Q.bsw_r_bavaria = 0;

Q.total_r_bavaria = 0;

if (Q.spd_r_bavaria) Q.total_r_bavaria += Q.spd_r_bavaria;
if (Q.linke_r_bavaria) Q.total_r_bavaria += Q.linke_r_bavaria;
if (Q.greens_r_bavaria) Q.total_r_bavaria += Q.greens_r_bavaria;
if (Q.fw_r_bavaria) Q.total_r_bavaria += Q.fw_r_bavaria;
if (Q.afd_r_bavaria) Q.total_r_bavaria += Q.afd_r_bavaria;
if (Q.csu_r_bavaria) Q.total_r_bavaria += Q.csu_r_bavaria;
if (Q.bsw_r_bavaria) Q.total_r_bavaria += Q.bsw_r_bavaria;

if (Q.total_r_bavaria > 0) {
    Q.spd_r_bavaria = (Q.spd_r_bavaria / Q.total_r_bavaria) * 100;
    Q.linke_r_bavaria = (Q.linke_r_bavaria / Q.total_r_bavaria) * 100;
    Q.greens_r_bavaria = (Q.greens_r_bavaria / Q.total_r_bavaria) * 100;
    Q.fw_r_bavaria = (Q.fw_r_bavaria / Q.total_r_bavaria) * 100;
    Q.afd_r_bavaria = (Q.afd_r_bavaria / Q.total_r_bavaria) * 100;
    Q.csu_r_bavaria = (Q.csu_r_bavaria / Q.total_r_bavaria) * 100;
    Q.bsw_r_bavaria = (Q.bsw_r_bavaria / Q.total_r_bavaria) * 100;
}

function allocateSeats(percentages, totalSeats = 203) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_r_bavaria: Q.spd_r_bavaria,
    linke_r_bavaria: Q.linke_r_bavaria,
    greens_r_bavaria: Q.greens_r_bavaria,
    fw_r_bavaria: Q.fw_r_bavaria,
    afd_r_bavaria: Q.afd_r_bavaria,
    csu_r_bavaria: Q.csu_r_bavaria,
    bsw_r_bavaria: Q.bsw_r_bavaria,
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 203).toFixed(1));
}

///////////////////// potential coalition calculation /////////////////////////

Q.bavaria_pot_groko = parseFloat((Q.spd_r_bavaria + Q.csu_r_bavaria).toFixed(1));
Q.bavaria_pot_traffic_light = parseFloat((Q.fw_r_bavaria + Q.spd_r_bavaria + Q.greens_r_bavaria).toFixed(1));
Q.bavaria_pot_jamaica = parseFloat((Q.greens_r_bavaria + Q.csu_r_bavaria + Q.fw_r_bavaria).toFixed(1));
Q.bavaria_pot_rot_rot = parseFloat((Q.linke_r_bavaria + Q.spd_r_bavaria).toFixed(1));
Q.bavaria_pot_tigerenten = parseFloat((Q.csu_r_bavaria + Q.fw_r_bavaria).toFixed(1));
Q.bavaria_pot_kiwi = parseFloat((Q.csu_r_bavaria + Q.greens_r_bavaria).toFixed(1));
Q.bavaria_pot_tigerenten = parseFloat((Q.csu_r_bavaria + Q.fw_r_bavaria).toFixed(1));
Q.bavaria_pot_die_linke_maj = parseFloat((Q.linke_r_bavaria).toFixed(1));
Q.bavaria_pot_die_linke_maj = parseFloat((Q.linke_r_bavaria).toFixed(1));
Q.bavaria_pot_afd_maj = parseFloat((Q.afd_r_bavaria).toFixed(1));
Q.bavaria_pot_rot_grun = parseFloat((Q.spd_r_bavaria + Q.greens_r_bavaria).toFixed(1));
Q.bavaria_pot_rot_rot_grun = parseFloat((Q.spd_r_bavaria + Q.greens_r_bavaria + Q.linke_r_bavaria).toFixed(1));
Q.bavaria_pot_spd_maj = parseFloat((Q.spd_r_bavaria).toFixed(1));
Q.bavaria_pot_green_maj = parseFloat((Q.greens_r_bavaria).toFixed(1));
Q.bavaria_pot_csu_maj = parseFloat((Q.csu_r_bavaria).toFixed(1));
Q.bavaria_pot_weimar_but_different = parseFloat((Q.csu_r_bavaria + Q.fw_r_bavaria + Q.spd_r_bavaria).toFixed(1));
Q.bavaria_pot_kenya = parseFloat((Q.csu_r_bavaria + Q.greens_r_bavaria + Q.spd_r_bavaria).toFixed(1));
Q.bavaria_pot_schwarz_blau = parseFloat((Q.csu_r_bavaria + Q.afd_r_bavaria).toFixed(1));
Q.bavaria_pot_red_purple = parseFloat((Q.bsw_r_bavaria + Q.linke_r_bavaria).toFixed(1));
Q.bavaria_pot_brombeer = parseFloat((Q.bsw_r_bavaria + Q.csu_r_bavaria + Q.spd_r_bavaria).toFixed(1));
Q.bavaria_pot_querfront = parseFloat((Q.bsw_r_bavaria + Q.afd_r_bavaria).toFixed(1));

Q.linke_bavaria_elections_vote = (Q.linke_bavaria_elections_vote != undefined ? parseFloat(Q.linke_bavaria_elections_vote.toFixed(1)) : 0);
Q.spd_bavaria_elections_vote = (Q.spd_bavaria_elections_vote != undefined ? parseFloat(Q.spd_bavaria_elections_vote.toFixed(1)) : 0);
Q.spd_r_bavaria = (Q.spd_r_bavaria != undefined ? parseFloat(Q.spd_r_bavaria.toFixed(1)) : 0);

!}
on-display: {!
var data = [];

/////////////////////////////// push diagram data ////////////////////////////////////

if (Q.bsw_bavaria_elections_vote >= 5) {
    data.push({
        "id": "bsw",
        "legend": "BSW",
        "name": "BSW",
        "seats": Math.round(Q.bsw_r_bavaria * 2.03)
    });
}

if (Q.linke_bavaria_elections_vote >= 5) {
    data.push({
        "id": "linke",
        "legend": "Left",
        "name": "Left",
        "seats": Math.round(Q.linke_r_bavaria * 2.03)
    });
}

if (Q.spd_bavaria_elections_vote >= 5) {
    data.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Math.round(Q.spd_r_bavaria * 2.03)
    });
}

if (Q.greens_bavaria_elections_vote >= 5) {
    data.push({
        "id": "greens",
        "legend": "B90/Greens",
        "name": "B90/Greens",
        "seats": Math.round(Q.greens_r_bavaria * 2.03)
    });
}

if (Q.fw_bavaria_elections_vote >= 5) {
    data.push({
        "id": "fw",
        "legend": "Free Voters",
        "name": "Free Voters",
        "seats": Math.round(Q.fw_r_bavaria * 2.03)
    });
}

if (Q.csu_bavaria_elections_vote >= 5) {
    data.push({
        "id": "csu",
        "legend": "CSU",
        "name": "CSU",
        "seats": Math.round(Q.csu_r_bavaria * 2.03)
    });
}

if (Q.afd_bavaria_elections_vote >= 5) {
    data.push({
        "id": "afd",
        "legend": "AfD",
        "name": "AfD",
        "seats": Math.round(Q.afd_r_bavaria * 2.03)
    });
}
setTimeout(function() {
    if (window && window.d3) {
        var width = 500;
        var height = 500;
        var contentDiv = document.getElementById('content');

        if (!contentDiv) return; 

        var screenWidth = contentDiv.offsetWidth;
        if (screenWidth < width - 50) {
            width = screenWidth - 50;
            height = width;
            var svgElement = document.getElementById("bavaria_landtag");
            if (svgElement) {
                svgElement.style.height = (screenWidth / 2) + "px";
            }
        }

        var parliament = d3.parliament();
        parliament.width(width).height(height).innerRadiusCoef(0.4);
        parliament.enter.fromCenter(true).smallToBig(true);
        parliament.exit.toCenter(false).bigToSmall(true);

        d3.select("#bavaria_landtag").selectAll("*").remove();
        d3.select("#bavaria_landtag").datum(data).call(parliament);
    }
}, 203);

!}

