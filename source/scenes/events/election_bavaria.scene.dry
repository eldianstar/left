@ampel
view-if: bavaria_pot_traffic_light >= 50 and ampelkoalition_failed = 0 and bavaria_pot_kiwi < 50
on-arrival: spd_relation -= 1; greens_relation -= 1; bavaria_groko = 0; bavaria_traffic_light = 1; bavaria_rot_rot_grun = 0; bavaria_jamaica = 0; bavaria_rot_rot = 0; bavaria_kenya = 0; bavaria_schwarz_blau = 0; bavaria_tigerenten = 0; bavaria_kiwi = 0; bavaria_die_linke_maj = 0; bavaria_afd_maj = 0; bavaria_rot_grun = 0; bavaria_spd_maj = 0; bavaria_green_maj = 0; bavaria_csu_maj = 0; bavaria_weimar_but_different = 0; bavaria_red_purple = 0; bavaria_brombeer = 0; bavaria_querfront = 0;

