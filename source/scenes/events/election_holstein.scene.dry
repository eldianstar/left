title: Schleswig-Holstein state election
subtitle: The people of Schleswig-Holstein head to the polls..
view-if: (year = next_election_year_holstein and month >= next_election_month_holstein) or (year > next_election_year_holstein)
new-page: true
tags: event
on-arrival: holstein_election_seen += 1; holstein_election_seen_time = time; holstein_most_recent = time;
on-departure: {! 
Q.next_election_year_holstein = Q.next_election_year_holstein + 4; 
Q.n_elections_holstein += 1;
Q.next_election_time_holstein = Q.time + 48;
!}
priority: 2
face-image: img/holstein.png

= Schleswig-Holstein state election, [+ month : month +] [+ year +]

The regularly scheduled elections for the Schleswig-Holstein Landtag are to take place. The incumbent government is a [? if holstein_groko = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span> ?][? if holstein_traffic_light = 1 : <span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ fdp_color +];">Yellow</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if holstein_rot_rot_grun = 1 : <span style="color: [+ linke_color +];">Red</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if holstein_jamaica = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ fdp_color +];">Yellow</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if holstein_rot_rot = 1 : <span style="color: [+ linke_color +];">Red</span>-<span style="color: [+ spd_color +];">Red</span> ?][? if holstein_kenya = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if holstein_schwarz_blau = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ afd_color +];">Blue</span> ?][? if holstein_tigerenten = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ fdp_color +];">Yellow</span> ?][? if holstein_kiwi = 1 : <span style="color: [+ greens_color +];">Green</span>-<span style="color: [+ cdu_color +];">Black</span> ?][? if holstein_die_linke_maj = 1 : <span style="color: [+ linke_color +];">Red</span> ?][? if holstein_afd_maj = 1 : <span style="color: [+ afd_color +];">Blue</span> ?][? if holstein_rot_grun = 1 : <span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ greens_color +];">Green</span> ?][? if holstein_spd_maj = 1 : <span style="color: [+ spd_color +];">Red</span> ?][? if holstein_green_maj = 1 : <span style="color: [+ greens_color +];">Green</span> ?][? if holstein_cdu_maj = 1 : <span style="color: [+ cdu_color +];">Black</span> ?][? if holstein_weimar_but_different = 1 : <span style="color: [+ cdu_color +];">Black</span>-<span style="color: [+ spd_color +];">Red</span>-<span style="color: [+ fdp_color +];">Yellow</span> ?] government.

- @holstein: May we do our best...

@holstein
on-arrival: {!

var holstein_adjustment_factors = {
    spd: 0.90,
    linke: 0.45,
    fdp: 0.85,
    cdu: 1.55,
    afd: 0.5,
    greens: 0.9,
    bsw: 0.55,
    ssw: 1,
};

Q.spd_r_holstein = 0;
Q.linke_r_holstein = 0;
Q.cdu_r_holstein = 0;
Q.greens_r_holstein = 0;
Q.afd_r_holstein = 0;
Q.fdp_r_holstein = 0;
Q.bsw_r_holstein = 0;
Q.ssw_r_holstein = 0;

Q.spd_holstein_elections_vote = 0;
Q.linke_holstein_elections_vote = 0;
Q.fdp_holstein_elections_vote = 0;
Q.afd_holstein_elections_vote = 0;
Q.greens_holstein_elections_vote = 0;
Q.cdu_holstein_elections_vote = 0;
Q.bsw_holstein_elections_vote = 0;
Q.ssw_holstein_elections_vote = 0;
             
///////////////////// class-based proportions votes ////////////////////////////////

if (Q.urban_linke > (Q.votes_linke + 3)) holstein_adjustment_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 3)) holstein_adjustment_factors.linke += 0.1;
if (Q.urban_linke > (Q.votes_linke + 6)) holstein_adjustment_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 6)) holstein_adjustment_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 6)) holstein_adjustment_factors.linke += 0.05;
if (Q.urban_linke > (Q.votes_linke + 15)) holstein_adjustment_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 15)) holstein_adjustment_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 15)) holstein_adjustment_factors.linke += 0.05;

if (Q.urban_spd > (Q.votes_spd + 3)) holstein_adjustment_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 3)) holstein_adjustment_factors.spd += 0.1;
if (Q.urban_spd > (Q.votes_spd + 6)) holstein_adjustment_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 6)) holstein_adjustment_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 6)) holstein_adjustment_factors.spd += 0.05;
if (Q.urban_spd > (Q.votes_spd + 15)) holstein_adjustment_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 15)) holstein_adjustment_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 15)) holstein_adjustment_factors.spd += 0.05;

if (Q.urban_greens > (Q.votes_greens + 3)) holstein_adjustment_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 3)) holstein_adjustment_factors.greens += 0.1;
if (Q.urban_greens > (Q.votes_greens + 6)) holstein_adjustment_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 6)) holstein_adjustment_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 6)) holstein_adjustment_factors.greens += 0.05;
if (Q.urban_greens > (Q.votes_greens + 15)) holstein_adjustment_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 15)) holstein_adjustment_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 15)) holstein_adjustment_factors.greens += 0.05;

if (Q.urban_fdp > (Q.votes_fdp + 3)) holstein_adjustment_factors.fdp += 0.1;
if (Q.rural_fdp > (Q.votes_fdp + 3)) holstein_adjustment_factors.fdp += 0.1;
if (Q.urban_fdp > (Q.votes_fdp + 6)) holstein_adjustment_factors.fdp += 0.1;
if (Q.rural_fdp > (Q.votes_fdp + 6)) holstein_adjustment_factors.fdp += 0.1;
if (Q.youth_fdp > (Q.votes_fdp + 6)) holstein_adjustment_factors.fdp += 0.05;
if (Q.urban_fdp > (Q.votes_fdp + 15)) holstein_adjustment_factors.fdp += 0.1;
if (Q.rural_fdp > (Q.votes_fdp + 15)) holstein_adjustment_factors.fdp += 0.1;
if (Q.youth_fdp > (Q.votes_fdp + 15)) holstein_adjustment_factors.fdp += 0.05;

if (Q.urban_cdu > (Q.votes_cdu + 3)) holstein_adjustment_factors.cdu += 0.1;
if (Q.rural_cdu > (Q.votes_cdu + 3)) holstein_adjustment_factors.cdu += 0.1;
if (Q.urban_cdu > (Q.votes_cdu + 6)) holstein_adjustment_factors.cdu += 0.1;
if (Q.rural_cdu > (Q.votes_cdu + 6)) holstein_adjustment_factors.cdu += 0.1;
if (Q.youth_cdu > (Q.votes_cdu + 6)) holstein_adjustment_factors.cdu += 0.05;
if (Q.urban_cdu > (Q.votes_cdu + 15)) holstein_adjustment_factors.cdu += 0.1;
if (Q.rural_cdu > (Q.votes_cdu + 15)) holstein_adjustment_factors.cdu += 0.1;
if (Q.youth_cdu > (Q.votes_cdu + 15)) holstein_adjustment_factors.cdu += 0.05;

if (Q.urban_afd > (Q.votes_afd + 3)) holstein_adjustment_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 3)) holstein_adjustment_factors.afd += 0.1;
if (Q.urban_afd > (Q.votes_afd + 6)) holstein_adjustment_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 6)) holstein_adjustment_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 6)) holstein_adjustment_factors.afd += 0.05;
if (Q.urban_afd > (Q.votes_afd + 15)) holstein_adjustment_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 15)) holstein_adjustment_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 15)) holstein_adjustment_factors.afd += 0.05;

////////////////// calculate seats votes ///////////////////////////////

Q.spd_holstein_elections_vote = Q.spd_votes*holstein_adjustment_factors.spd;
Q.linke_holstein_elections_vote = Q.linke_votes*holstein_adjustment_factors.linke;
Q.fdp_holstein_elections_vote = Q.fdp_votes*holstein_adjustment_factors.fdp;
if (Q.issue_migration >= 5) holstein_adjustment_factors.afd += 0.2;
Q.afd_holstein_elections_vote = Q.afd_votes*holstein_adjustment_factors.afd;
Q.cdu_holstein_elections_vote = Q.cdu_votes*holstein_adjustment_factors.cdu;
if (Q.issue_environment >= 5) holstein_adjustment_factors.greens += 0.1;
Q.greens_holstein_elections_vote = Q.greens_votes*holstein_adjustment_factors.greens;
Q.bsw_holstein_elections_vote = Q.bsw_votes*holstein_adjustment_factors.bsw;
Q.ssw_holstein_elections_vote = 6*holstein_adjustment_factors.ssw;

Q.total_votes_holstein = Q.spd_holstein_elections_vote + Q.linke_holstein_elections_vote + Q.greens_holstein_elections_vote + Q.fdp_holstein_elections_vote + Q.cdu_holstein_elections_vote + Q.afd_holstein_elections_vote + Q.bsw_holstein_elections_vote + Q.ssw_holstein_elections_vote;

if (Q.total_votes_holstein > 0) {
    Q.spd_holstein_elections_vote = (Q.spd_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.linke_holstein_elections_vote = (Q.linke_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.greens_holstein_elections_vote = (Q.greens_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.fdp_holstein_elections_vote = (Q.fdp_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.afd_holstein_elections_vote = (Q.afd_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.cdu_holstein_elections_vote = (Q.cdu_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.bsw_holstein_elections_vote = (Q.bsw_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.ssw_holstein_elections_vote = (Q.ssw_holstein_elections_vote / Q.total_votes_holstein) * 100;
    let target = 2;
    Q.linke_holstein_elections_vote = Math.round((Q.linke_holstein_elections_vote + (target - Q.linke_holstein_elections_vote) * 0.35) * 10) / 10;
    Q.total_votes_holstein = Q.spd_holstein_elections_vote + Q.linke_holstein_elections_vote + Q.greens_holstein_elections_vote + Q.fdp_holstein_elections_vote + Q.afd_holstein_elections_vote + Q.cdu_holstein_elections_vote + Q.bsw_holstein_elections_vote + Q.ssw_holstein_elections_vote;
    Q.spd_holstein_elections_vote = (Q.spd_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.linke_holstein_elections_vote = (Q.linke_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.greens_holstein_elections_vote = (Q.greens_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.fdp_holstein_elections_vote = (Q.fdp_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.afd_holstein_elections_vote = (Q.afd_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.cdu_holstein_elections_vote = (Q.cdu_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.bsw_holstein_elections_vote = (Q.bsw_holstein_elections_vote / Q.total_votes_holstein) * 100;
    Q.ssw_holstein_elections_vote = (Q.ssw_holstein_elections_vote / Q.total_votes_holstein) * 100;
}

Q.spd_holstein_elections_vote = (Q.spd_holstein_elections_vote != undefined ? parseFloat(Q.spd_holstein_elections_vote.toFixed(1)) : 0);
Q.linke_holstein_elections_vote = (Q.linke_holstein_elections_vote != undefined ? parseFloat(Q.linke_holstein_elections_vote.toFixed(1)) : 0);
Q.greens_holstein_elections_vote = (Q.greens_holstein_elections_vote != undefined ? parseFloat(Q.greens_holstein_elections_vote.toFixed(1)) : 0);
Q.fdp_holstein_elections_vote = (Q.fdp_holstein_elections_vote != undefined ? parseFloat(Q.fdp_holstein_elections_vote.toFixed(1)) : 0);
Q.afd_holstein_elections_vote = (Q.afd_holstein_elections_vote != undefined ? parseFloat(Q.afd_holstein_elections_vote.toFixed(1)) : 0);
Q.cdu_holstein_elections_vote = (Q.cdu_holstein_elections_vote != undefined ? parseFloat(Q.cdu_holstein_elections_vote.toFixed(1)) : 0);
Q.bsw_holstein_elections_vote = (Q.bsw_holstein_elections_vote != undefined ? parseFloat(Q.bsw_holstein_elections_vote.toFixed(1)) : 0);
Q.ssw_holstein_elections_vote = (Q.ssw_holstein_elections_vote != undefined ? parseFloat(Q.bsw_holstein_elections_vote.toFixed(1)) : 0);
             
/////////////////////////// adj factors seats ////////////////////////////

var holstein_adjustment_r_factors = {
    spd: 0.90,
    linke: 0.45,
    fdp: 0.85,
    cdu: 1.55,
    afd: 0.5,
    greens: 0.9,
    bsw: 0.55,
    ssw: 1,
};

//////////////////////////// class based seats ///////////////////////////////

if (Q.urban_linke > (Q.votes_linke + 3)) holstein_adjustment_r_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 3)) holstein_adjustment_r_factors.linke += 0.1;
if (Q.urban_linke > (Q.votes_linke + 6)) holstein_adjustment_r_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 6)) holstein_adjustment_r_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 6)) holstein_adjustment_r_factors.linke += 0.05;
if (Q.urban_linke > (Q.votes_linke + 15)) holstein_adjustment_r_factors.linke += 0.1;
if (Q.rural_linke > (Q.votes_linke + 15)) holstein_adjustment_r_factors.linke += 0.1;
if (Q.youth_linke > (Q.votes_linke + 15)) holstein_adjustment_r_factors.linke += 0.05;

if (Q.urban_spd > (Q.votes_spd + 3)) holstein_adjustment_r_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 3)) holstein_adjustment_r_factors.spd += 0.1;
if (Q.urban_spd > (Q.votes_spd + 6)) holstein_adjustment_r_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 6)) holstein_adjustment_r_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 6)) holstein_adjustment_r_factors.spd += 0.05;
if (Q.urban_spd > (Q.votes_spd + 15)) holstein_adjustment_r_factors.spd += 0.1;
if (Q.rural_spd > (Q.votes_spd + 15)) holstein_adjustment_r_factors.spd += 0.1;
if (Q.youth_spd > (Q.votes_spd + 15)) holstein_adjustment_r_factors.spd += 0.05;

if (Q.urban_greens > (Q.votes_greens + 3)) holstein_adjustment_r_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 3)) holstein_adjustment_r_factors.greens += 0.1;
if (Q.urban_greens > (Q.votes_greens + 6)) holstein_adjustment_r_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 6)) holstein_adjustment_r_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 6)) holstein_adjustment_r_factors.greens += 0.05;
if (Q.urban_greens > (Q.votes_greens + 15)) holstein_adjustment_r_factors.greens += 0.1;
if (Q.rural_greens > (Q.votes_greens + 15)) holstein_adjustment_r_factors.greens += 0.1;
if (Q.youth_greens > (Q.votes_greens + 15)) holstein_adjustment_r_factors.greens += 0.05;

if (Q.urban_fdp > (Q.votes_fdp + 3)) holstein_adjustment_r_factors.fdp += 0.1;
if (Q.rural_fdp > (Q.votes_fdp + 3)) holstein_adjustment_r_factors.fdp += 0.1;
if (Q.urban_fdp > (Q.votes_fdp + 6)) holstein_adjustment_r_factors.fdp += 0.1;
if (Q.rural_fdp > (Q.votes_fdp + 6)) holstein_adjustment_r_factors.fdp += 0.1;
if (Q.youth_fdp > (Q.votes_fdp + 6)) holstein_adjustment_r_factors.fdp += 0.05;
if (Q.urban_fdp > (Q.votes_fdp + 15)) holstein_adjustment_r_factors.fdp += 0.1;
if (Q.rural_fdp > (Q.votes_fdp + 15)) holstein_adjustment_r_factors.fdp += 0.1;
if (Q.youth_fdp > (Q.votes_fdp + 15)) holstein_adjustment_r_factors.fdp += 0.05;

if (Q.urban_cdu > (Q.votes_cdu + 3)) holstein_adjustment_r_factors.cdu += 0.1;
if (Q.rural_cdu > (Q.votes_cdu + 3)) holstein_adjustment_r_factors.cdu += 0.1;
if (Q.urban_cdu > (Q.votes_cdu + 6)) holstein_adjustment_r_factors.cdu += 0.1;
if (Q.rural_cdu > (Q.votes_cdu + 6)) holstein_adjustment_r_factors.cdu += 0.1;
if (Q.youth_cdu > (Q.votes_cdu + 6)) holstein_adjustment_r_factors.cdu += 0.05;
if (Q.urban_cdu > (Q.votes_cdu + 15)) holstein_adjustment_r_factors.cdu += 0.1;
if (Q.rural_cdu > (Q.votes_cdu + 15)) holstein_adjustment_r_factors.cdu += 0.1;
if (Q.youth_cdu > (Q.votes_cdu + 15)) holstein_adjustment_r_factors.cdu += 0.05;

if (Q.urban_afd > (Q.votes_afd + 3)) holstein_adjustment_r_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 3)) holstein_adjustment_r_factors.afd += 0.1;
if (Q.urban_afd > (Q.votes_afd + 6)) holstein_adjustment_r_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 6)) holstein_adjustment_r_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 6)) holstein_adjustment_r_factors.afd += 0.05;
if (Q.urban_afd > (Q.votes_afd + 15)) holstein_adjustment_r_factors.afd += 0.1;
if (Q.rural_afd > (Q.votes_afd + 15)) holstein_adjustment_r_factors.afd += 0.1;
if (Q.youth_afd > (Q.votes_afd + 15)) holstein_adjustment_r_factors.afd += 0.05;


Q.spd_r_holstein = Q.spd_votes*holstein_adjustment_r_factors.spd;
Q.linke_r_holstein = Q.linke_votes*holstein_adjustment_r_factors.linke;
Q.fdp_r_holstein = Q.fdp_votes*holstein_adjustment_r_factors.fdp;
if (Q.issue_migration >= 5) holstein_adjustment_factors.afd += 0.2;
Q.afd_r_holstein = Q.afd_votes*holstein_adjustment_r_factors.afd;
Q.cdu_r_holstein = Q.cdu_votes*holstein_adjustment_r_factors.cdu;
if (Q.issue_environment >= 5) holstein_adjustment_r_factors.greens += 0.1;
Q.greens_r_holstein = Q.greens_votes*holstein_adjustment_r_factors.greens;
Q.bsw_r_holstein = Q.bsw_votes*holstein_adjustment_r_factors.bsw;
Q.ssw_r_holstein = 6*holstein_adjustment_r_factors.ssw;
             
if (Q.spd_holstein_elections_vote < 5) Q.spd_r_holstein = 0;
if (Q.linke_holstein_elections_vote < 5) Q.linke_r_holstein = 0;
if (Q.greens_holstein_elections_vote < 5) Q.greens_r_holstein = 0;
if (Q.fdp_holstein_elections_vote < 5) Q.fdp_r_holstein = 0;
if (Q.afd_holstein_elections_vote < 5) Q.afd_r_holstein = 0;
if (Q.cdu_holstein_elections_vote < 5) Q.cdu_r_holstein = 0;
if (Q.bsw_holstein_elections_vote < 5) Q.bsw_r_holstein = 0;
if (Q.ssw_holstein_elections_vote < 5) Q.ssw_r_holstein = 0;
             
Q.total_r_holstein = 0;

if (Q.spd_r_holstein) Q.total_r_holstein += Q.spd_r_holstein;
if (Q.linke_r_holstein) Q.total_r_holstein += Q.linke_r_holstein;
if (Q.greens_r_holstein) Q.total_r_holstein += Q.greens_r_holstein;
if (Q.fdp_r_holstein) Q.total_r_holstein += Q.fdp_r_holstein;
if (Q.afd_r_holstein) Q.total_r_holstein += Q.afd_r_holstein;
if (Q.cdu_r_holstein) Q.total_r_holstein += Q.cdu_r_holstein;
if (Q.bsw_r_holstein) Q.total_r_holstein += Q.bsw_r_holstein;
if (Q.ssw_r_holstein) Q.total_r_holstein += Q.ssw_r_holstein;          

if (Q.total_r_holstein > 0) {
    Q.spd_r_holstein = (Q.spd_r_holstein / Q.total_r_holstein) * 100;
    Q.linke_r_holstein = (Q.linke_r_holstein / Q.total_r_holstein) * 100;
    Q.greens_r_holstein = (Q.greens_r_holstein / Q.total_r_holstein) * 100;
    Q.fdp_r_holstein = (Q.fdp_r_holstein / Q.total_r_holstein) * 100;
    Q.afd_r_holstein = (Q.afd_r_holstein / Q.total_r_holstein) * 100;
    Q.cdu_r_holstein = (Q.cdu_r_holstein / Q.total_r_holstein) * 100;
    Q.bsw_r_holstein = (Q.bsw_r_holstein / Q.total_r_holstein) * 100;
    Q.ssw_r_holstein = (Q.ssw_r_holstein / Q.total_r_holstein) * 100;
}

function allocateSeats(percentages, totalSeats = 69) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_r_holstein: Q.spd_r_holstein,
    linke_r_holstein: Q.linke_r_holstein,
    greens_r_holstein: Q.greens_r_holstein,
    fdp_r_holstein: Q.fdp_r_holstein,
    afd_r_holstein: Q.afd_r_holstein,
    cdu_r_holstein: Q.cdu_r_holstein,
    bsw_r_holstein: Q.bsw_r_holstein,
    ssw_r_holstein: Q.ssw_r_holstein,
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 69).toFixed(1));
}

///////////////////// potential coalition calculation /////////////////////////

Q.holstein_pot_groko = parseFloat((Q.spd_r_holstein + Q.cdu_r_holstein).toFixed(1));
Q.holstein_pot_traffic_light = parseFloat((Q.fdp_r_holstein + Q.spd_r_holstein + Q.greens_r_holstein).toFixed(1));
Q.holstein_pot_jamaica = parseFloat((Q.greens_r_holstein + Q.cdu_r_holstein + Q.fdp_r_holstein).toFixed(1));
Q.holstein_pot_rot_rot = parseFloat((Q.linke_r_holstein + Q.spd_r_holstein).toFixed(1));
Q.holstein_pot_tigerenten = parseFloat((Q.cdu_r_holstein + Q.fdp_r_holstein).toFixed(1));
Q.holstein_pot_kiwi = parseFloat((Q.cdu_r_holstein + Q.greens_r_holstein).toFixed(1));
Q.holstein_pot_tigerenten = parseFloat((Q.cdu_r_holstein + Q.fdp_r_holstein).toFixed(1));
Q.holstein_pot_die_linke_maj = parseFloat((Q.linke_r_holstein).toFixed(1));
Q.holstein_pot_die_linke_maj = parseFloat((Q.linke_r_holstein).toFixed(1));
Q.holstein_pot_afd_maj = parseFloat((Q.afd_r_holstein).toFixed(1));
Q.holstein_pot_rot_grun = parseFloat((Q.spd_r_holstein + Q.greens_r_holstein).toFixed(1));
Q.holstein_pot_rot_rot_grun = parseFloat((Q.spd_r_holstein + Q.greens_r_holstein + Q.linke_r_holstein).toFixed(1));
Q.holstein_pot_spd_maj = parseFloat((Q.spd_r_holstein).toFixed(1));
Q.holstein_pot_green_maj = parseFloat((Q.greens_r_holstein).toFixed(1));
Q.holstein_pot_cdu_maj = parseFloat((Q.cdu_r_holstein).toFixed(1));
Q.holstein_pot_weimar_but_different = parseFloat((Q.cdu_r_holstein + Q.fdp_r_holstein + Q.spd_r_holstein).toFixed(1));
Q.holstein_pot_kenya = parseFloat((Q.cdu_r_holstein + Q.greens_r_holstein + Q.spd_r_holstein).toFixed(1));
Q.holstein_pot_schwarz_blau = parseFloat((Q.cdu_r_holstein + Q.afd_r_holstein).toFixed(1));
Q.holstein_pot_red_purple = parseFloat((Q.bsw_r_holstein + Q.linke_r_holstein).toFixed(1));
Q.holstein_pot_brombeer = parseFloat((Q.bsw_r_holstein + Q.cdu_r_holstein + Q.spd_r_holstein).toFixed(1));
Q.holstein_pot_querfront = parseFloat((Q.bsw_r_holstein + Q.afd_r_holstein).toFixed(1));

Q.linke_holstein_elections_vote = (Q.linke_holstein_elections_vote != undefined ? parseFloat(Q.linke_holstein_elections_vote.toFixed(1)) : 0);
Q.spd_holstein_elections_vote = (Q.spd_holstein_elections_vote != undefined ? parseFloat(Q.spd_holstein_elections_vote.toFixed(1)) : 0);
Q.spd_r_holstein = (Q.spd_r_holstein != undefined ? parseFloat(Q.spd_r_holstein.toFixed(1)) : 0);

!}
on-display: {!
var data = [];

/////////////////////////////// push diagram data ////////////////////////////////////

if (Q.bsw_holstein_elections_vote >= 5) {
    data.push({
        "id": "bsw",
