{!<tr><td><div class="box" style='background-color:#E3000F'> </div> !}<span style="color: [+ spd_color +];">**SPD**</span>: {!</td><td>!} [+ spd_berlin_elections_vote +]% {!</td><td>!} [+ spd_r_berlin +]% {!</td></tr>!} 

{!<tr><td><div class="box" style='background-color:#1AA037'> </div> !}<span style="color: [+ greens_color +];">**B90/Greens**</span>: {!</td><td>!} [+ greens_berlin_elections_vote +]% {!</td><td>!} [+ greens_r_berlin +]% {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#FFD600'> </div> !}<span style="color: [+ fdp_color +];">**FDP**</span>: {!</td><td>!} [+ fdp_berlin_elections_vote +]% {!</td><td>!} [+ fdp_r_berlin +]%  {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#000000'> </div> !}<span style="color: [+ cdu_color +];">**CDU**</span>: {!</td><td>!} [+ cdu_berlin_elections_vote +]% {!</td><td>!} [+ cdu_r_berlin +]%  {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#0489db'> </div> !} <span style="color: [+ afd_color +];">**AfD**</span>: {!</td><td>!} [+ afd_berlin_elections_vote +]% {!</td><td>!} [+ afd_r_berlin +]%  {!</td></tr>!} 

{!</table>!}
<hr id="read-marker">

Grand Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ spd_color +];">SPD</span>): [+ berlin_pot_groko +]%

Traffic Light Coalition (<span style="color: [+ spd_color +];">SPD</span> + <span style="color: [+ fdp_color +];">FDP</span> + <span style="color: [+ greens_color +];">Greens</span>): [+ berlin_pot_traffic_light +]%

Red-Red-Green Coalition (<span style="color: [+ linke_color +];">The Left</span> + <span style="color: [+ spd_color +];">SPD</span> + <span style="color: [+ greens_color +];">Greens</span>): [+ berlin_pot_rot_rot_grun +]%

Jamaica Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ fdp_color +];">FDP</span> + <span style="color: [+ greens_color +];">Greens</span>): [+ berlin_pot_jamaica +]%

Red-Red Coalition (<span style="color: [+ linke_color +];">The Left</span> + <span style="color: [+ spd_color +];">SPD</span>): [+ berlin_pot_rot_rot +]%

Kenya Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ spd_color +];">SPD</span> + <span style="color: [+ greens_color +];">Greens</span>): [+ berlin_pot_kenya +]%

Black-Blue Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ afd_color +];">AfD</span>): [+ berlin_pot_schwarz_blau +]%

Tiger Duck Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ fdp_color +];">FDP</span>): [+ berlin_pot_tigerenten +]%

Kiwi Coalition (<span style="color: #11aa11;">Greens</span> + <span style="color: [+ cdu_color +];">CDU</span>): [+ berlin_pot_kiwi +]%

