{!<tr><td><div class="box" style='background-color:#BC2D72; outline: 2px; outline-style: solid;'> </div> !} <span style="color: [+ linke_color +];">**Die Linke**</span>: {!</td><td>!} **[+ linke_berlin_elections_vote +]%** {!</td><td>!} [+ linke_r_berlin +]% {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#E3000F'> </div> !}<span style="color: [+ spd_color +];">**SPD**</span>: {!</td><td>!} [+ spd_berlin_elections_vote +]% {!</td><td>!} [+ spd_r_berlin +]% {!</td></tr>!} 

{!<tr><td><div class="box" style='background-color:#1AA037'> </div> !}<span style="color: [+ greens_color +];">**B90/Greens**</span>: {!</td><td>!} [+ greens_berlin_elections_vote +]% {!</td><td>!} [+ greens_r_berlin +]% {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#FFD600'> </div> !}<span style="color: [+ fdp_color +];">**FDP**</span>: {!</td><td>!} [+ fdp_berlin_elections_vote +]% {!</td><td>!} [+ fdp_r_berlin +]%  {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#000000'> </div> !}<span style="color: [+ cdu_color +];">**CDU**</span>: {!</td><td>!} [+ cdu_berlin_elections_vote +]% {!</td><td>!} [+ cdu_r_berlin +]%  {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#0489db'> </div> !} <span style="color: [+ afd_color +];">**AfD**</span>: {!</td><td>!} [+ afd_berlin_elections_vote +]% {!</td><td>!} [+ afd_r_berlin +]%  {!</td></tr>!} 

{!</table>!}
<hr id="read-marker">

[? if berlin_pot_groko >= 45 : Grand Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ spd_color +];">SPD</span>): [+ berlin_pot_groko +]% ?]

[? if berlin_pot_traffic_light >= 45 : Traffic Light Coalition (<span style="color: [+ spd_color +];">SPD</span> + <span style="color: [+ fdp_color +];">FDP</span> + <span style="color: [+ greens_color +];">Greens</span>): [+ berlin_pot_traffic_light +]% ?]

[? if berlin_pot_rot_rot_grun >= 45 : Red-Red-Green Coalition (<span style="color: [+ linke_color +];">The Left</span> + <span style="color: [+ spd_color +];">SPD</span> + <span style="color: [+ greens_color +];">Greens</span>): [+ berlin_pot_rot_rot_grun +]% ?]

[? if berlin_pot_jamaica >= 45 : Jamaica Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ fdp_color +];">FDP</span> + <span style="color: [+ greens_color +];">Greens</span>): [+ berlin_pot_jamaica +]% ?]

[? if berlin_pot_rot_rot >= 45 : Red-Red Coalition (<span style="color: [+ linke_color +];">The Left</span> + <span style="color: [+ spd_color +];">SPD</span>): [+ berlin_pot_rot_rot +]% ?]

[? if berlin_pot_kenya >= 45 : Kenya Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ spd_color +];">SPD</span> + <span style="color: [+ greens_color +];">Greens</span>): [+ berlin_pot_kenya +]% ?]

[? if berlin_pot_schwarz_blau >= 45 : Midnight Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ afd_color +];">AfD</span>): [+ berlin_pot_schwarz_blau +]% ?]

[? if berlin_pot_tigerenten >= 45 : Tiger Duck Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ fdp_color +];">FDP</span>): [+ berlin_pot_tigerenten +]% ?]

[? if berlin_pot_kiwi >= 45 : Kiwi Coalition (<span style="color: [+ greens_color +];">Greens</span> + <span style="color: [+ cdu_color +];">CDU</span>): [+ berlin_pot_kiwi +]% ?]

[? if berlin_pot_rot_grun >= 45 : Red-Green Coalition (<span style="color: [+ spd_color +];">SPD</span> + <span style="color: [+ greens_color +];">Greens</span>): [+ berlin_pot_rot_grun +]% ?]

[? if berlin_pot_weimar_but_different >= 45 : Germany Coalition (<span style="color: [+ cdu_color +];">CDU</span> + <span style="color: [+ spd_color +];">SPD</span> + <span style="color: [+ fdp_color +];">FDP</span>): [+ berlin_pot_weimar_but_different +]% ?]

[? if berlin_pot_die_linke_maj >= 45 : Left Majority (<span style="color: [+ linke_color +];">The Left</span>): [+ berlin_pot_die_linke_maj +]% ?]

[? if berlin_pot_afd_maj >= 45 : AfD Majority (<span style="color: [+ afd_color +];">AfD</span>): [+ berlin_pot_afd_maj +]% ?]

