title: Post Event
new-page: true
on-arrival: {!

const q = dendryUI.dendryEngine.state.qualities;
const dynamicMode = q.dynamic_mode;
const historicalMode = q.historical_mode;

const newlyAddedAchievements = [];

if (Q.year == 2021 && Q.month <= 6) {
    Q.initialAchievements = Object.keys(q).filter(
        key => key.startsWith("game_achievement") || key.startsWith("achievement")
    );

    for (const key of [...Q.initialAchievements]) {
        if (key.startsWith("achievement") && !key.startsWith("game_")) {
            const gameKey = "game_" + key;
            if (!Q.initialAchievements.includes(gameKey)) {
                Q.initialAchievements.push(gameKey);
            }
        }
    }

    console.log(Q.initialAchievements);
}

const initialAchievements = Array.isArray(Q.initialAchievements)
  ? Q.initialAchievements
  : [];


if (Q.achievement_holy_moly) {
    const content = document.getElementById('content');
    if (content) {
      content.style.border = '3px solid black'
      content.style.boxShadow = '0 0 0 3px red, 0 0 0 6px gold';
    }

    if (Q.rubicon) {
        const content = document.getElementById('content');
        if (content) {
          content.style.border = ''
          content.style.boxShadow = '';
        }
    }
}

if (Q.rubicon && Q.chancellor != Q.nsdap_chancellor) {
const contentElement = document.getElementById('content');
contentElement.style.backgroundColor = '#645E51';

const header = document.querySelector('header');
header.style.color = '#0077FF';
contentElement.style.color = '#FFFFFF';

const isMobile = window.innerWidth <= 768;
const toolsElements = document.querySelectorAll('.tools');

toolsElements.forEach(tool => {
    if (isMobile) {
        tool.style.marginLeft = '';
        tool.style.padding = '0.6em';
        tool.style.width = '';
        tool.style.color = '#FFFFFF';
        tool.style.backgroundColor = '#645E51';
        tool.style.boxShadow = '4px 4px 16px rgba(255, 255, 255, 0.4)';
    } else {
        tool.style.marginLeft = '-6em';
        tool.style.padding = '0.6em';
        tool.style.width = '20rem';
        tool.style.color = '#FFFFFF';
        tool.style.backgroundColor = '#645E51';
        tool.style.boxShadow = '4px 4px 16px rgba(255, 255, 255, 0.4)';
    }
});

const qualitiesH1 = document.querySelector('#qualities h1');
if (qualitiesH1) {
    qualitiesH1.style.color = 'white';
}

const emergencyTab = document.getElementById('emergency_tab');
emergencyTab.style.display = '';
emergencyTab.style.width = '100%';

const headerLinks = document.querySelectorAll('#header-links a');
headerLinks.forEach(link => {
    link.style.color = 'black';
});

const tabContainer = document.querySelector('.tab_container');
if (tabContainer) {
    tabContainer.style.backgroundColor = '#c3b8a0';
}

const tabButtons = document.querySelectorAll('.tab_button');
tabButtons.forEach((button) => {
    button.style.backgroundColor = '#c3b8a0';
    if (button.id !== 'emergency_tab') {
        button.style.paddingRight = '59px';
    }
    if (button.id == 'main_tab') {
        button.style.marginLeft = '2px';
    }
    if (button.id == 'poll_tab') {
        button.style.display = 'none';
    }
});

const activeTabButton = document.querySelector('.tab_button.active');
if (activeTabButton) {
    activeTabButton.style.backgroundColor = '#f3f3f3';
}

tabButtons.forEach(button => {
    const computedStyle = window.getComputedStyle(button);
    const originalBackground = computedStyle.backgroundColor;
    button.addEventListener('mouseenter', () => {
        button.style.backgroundColor = '#a89f8b';
    });
    button.addEventListener('mouseleave', () => {
        if (!button.classList.contains('active')) {
            button.style.backgroundColor = originalBackground;
        }
    });
});

const rightTools = document.querySelector('.tools.right');
if (rightTools) {
    rightTools.style.display = 'block';
}
}

Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// make sure no stat is below 0.
for (var c of Q.classes) {
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
    }
}

if (Q.pro_status_quo < 0) {
    Q.pro_status_quo = 0;
}
if (Q.bundeswehr_strength < 0) {
    Q.bundeswehr_strength = 0;
}
if (Q.pro_status_quo >= 100) {
    Q.pro_status_quo = 99;
}
// re-calculate party support
// calculate normalized class voting for the achievements
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
// calculate support for each of the parties
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support'] = party_support;
    total_support += party_support;
}
// 2. normalize support (fraction)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    Q[party+'_votes'] = Math.round(Q[party+'_normalized']*1000)/ 10;
}


// set faction strength/dissent to 0
for (var c of Q.factions) {
    if (Q[c+'_dissent'] < 0) {
        Q[c+'_dissent'] = 0;
    } else if (Q[c+'_dissent'] >= 100) {
        Q[c+'_dissent'] = 99;
    }
    if (Q[c+'_strength'] < 0) {
        Q[c+'_strength'] = 0;
    }
}

if (Q.unemployed <= 1) {
    Q.unemployed = 1;
}

// re-calculate dissent.
var total_strength = Q.oldleft_strength + Q.beweli_strength + Q.emali_strength + Q.pragmatist_strength;
// normalize strength for the different factions
Q.oldleft_strength = 100*Q.oldleft_strength/total_strength;
Q.beweli_strength = 100*Q.beweli_strength/total_strength;
Q.emali_strength = 100*Q.emali_strength/total_strength;
Q.pragmatist_strength = 100*Q.pragmatist_strength/total_strength;

var total_dissent = Q.oldleft_strength*Q.oldleft_dissent + Q.beweli_strength*Q.beweli_dissent + Q.emali_strength*Q.emali_dissent + Q.pragmatist_strength*Q.pragmatist_dissent;
Q.dissent = 0.01*total_dissent/total_strength;
Q.dissent_percent = Q.dissent*100;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}




Q.month_actions_checked = Q.month_actions;

// 1. update dates
if ((Q.month_actions >= 1 && !Q.rubicon) || (Q.month_actions >= 4 && Q.rubicon)) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
        Q.resources += Q.dues;
        if (Q.dissent_percent < 5) {
            Q.resources += 1;
        } else if (Q.dissent_percent > 30) {
            Q.resources -= 1;
        }
    }
    // decrement timers
    if (!Q.rubicon) {
        for (timer of Q.timers) {
            if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
                Q[timer+'_timer'] -= 1;
            }
        }
    }  
    // append to historical party support records
    var party_support_results = {'date': new Date(Q.year, Q.month - 1)};
    for (var party of Q.parties_graph) {
        party_support_results[party] = Q[party + '_normalized']*100;
    }
    Q.party_support_records.push(party_support_results);
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1),
                             'inflation': Q.inflation,
                             'unemployment': Q.unemployed});
    // change economic stats...
    // we're basically implicity drawing a Philips curve
    // budget deficits lead to some inflation
    if (Q.budget <= 0 && Q.budget > -2 && Q.inflation < 2.5) {
        Q.inflation += 0.1;
    }
    if (Q.budget <= -2 && Q.budget > -5 && Q.inflation < 5) {
        Q.inflation += 0.2;
        if (Q.unemployed >= 12) {
            Q.inflation -= 0.1;
        }
    }
    if (Q.budget <= -5 && Q.inflation < 10) {
        Q.inflation += 0.3;
        if (Q.unemployed >= 15) {
            Q.inflation -= 0.1;
        }
    }
    // deflation is bad
    if (Q.inflation < -0.5 && Q.inflation > -5 && Q.unemployed < 15) {
        Q.unemployed += 0.1;
    }
    if (Q.inflation <= -5 && Q.unemployed < 20) {
        Q.unemployed += 0.1;
    }
    if (Q.inflation <= -8 && Q.unemployed < 26) {
        Q.unemployed += 0.1;
    }
    if (Q.inflation <= -12 && Q.unemployed < 32) {
        Q.unemployed += 0.1;
    }
    // economic growth
    if (Q.economic_growth < -0.5 && Q.unemployed <= 16) {
        Q.unemployed += 0.1;
    }
    if (Q.economic_growth < -5 && Q.unemployed <= 24) {
        Q.unemployed += 0.1;
    }
    if (Q.economic_growth >= 2 && Q.unemployed >= 17) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 4 && Q.unemployed >= 12) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 6 && Q.unemployed >= 7) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 8 && Q.unemployed >= 3) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 4 && Q.inflation >= 7.5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= -2.5 && Q.inflation <= -5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 7) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 10) {
        Q.economic_growth -= 0.2;
    }
    if (Q.economic_growth >= 12) {
        Q.economic_growth -= 0.3;
    }
    if (Q.economic_growth < -10) {
        Q.economic_growth += 0.1;
    }
    if (Q.economic_growth < -13) {
        Q.economic_growth += 0.1;
    }
    if (Q.economic_growth < -16) {
        Q.economic_growth += 0.1;
    }
    if (Q.economic_growth >= 3 && Q.unemployed < 20 && Q.black_thursday_seen) {
        Q.capital_strike_progress -= 0.25;
    }
    if (!Q.economic_democracy && !Q.nationalization_progress && Q.spd_in_government) {
        Q.capital_strike_progress -= 0.1;
    }
    if (Q.budget > 0 && Q.black_thursday_seen && Q.spd_in_government) {
        Q.capital_strike_progress += ((Q.upper_tax_rates - 5) / 25);
    }

    //////////////////////////////// Education & Science support/economic changes TODO
    // science bonus to economic growth
    Q.science_bonus = 0;
    if (Q.major_curriculum && Q.major_curriculum == "democratic") {
        if (Q.pro_republic < 60) {
            Q.pro_republic += 0.3;
        } 
    }
    if (Q.minor_curriculum && Q.minor_curriculum == "democratic") {
        if (Q.pro_republic < 60) {
            Q.pro_republic += 0.15;
        } 
    }
    // science bonus to economic growth
    // education bonus
    Q.science_bonus = 0;
    if (Q.education_science) {
        Q.science_bonus += Q.education_science;
    }
    if (Q.science) {
        if (Q.science >= 1) {
            Q.science_bonus += 1;
        } else if (Q.science >= 3) {
            Q.science_bonus += 2;
        } else if (Q.science >= 5) {
            Q.science_bonus += 3;
        }
    }
    if (Q.applied_research && Q.applied_research >= 1) {
        Q.science_bonus += 0.5*Q.applied_research;
    }
    // cap the science bonus at 6
    if (Q.science_bonus > 6) {
        Q.science_bonus = 6;
    }
    console.log(Q.science_bonus);
    // this is kinda messy but basically more science -> higher levels of baseline growth
    if (Q.science_bonus >= 1) {
        if (Q.return_to_normalcy && Q.economic_growth < Q.science_bonus + 3) {
            Q.economic_growth += 0.1;
        }
        if (Q.return_to_normalcy && Q.economic_growth < Q.science_bonus) {
            Q.economic_growth += 0.1;
        }
        if (Q.economic_growth < Q.science_bonus - 3) {
            Q.economic_growth += 0.1;
        }
    }
    // accumulated economic growth/decline
    // Maybe there should be differences for positive/negative growth?
    if (Q.economic_growth < 0) {
        if (Q.economic_expansion > 0) {
            Q.economic_expansion = 0;
        } else {
            Q.economic_expansion += Q.economic_growth;
        }
    }
    if (Q.economic_growth > 0 && Q.reparations <= -2 && Q.spd_in_government) {
        Q.economic_expansion += Q.economic_growth;
    } else if (Q.economic_growth > 0 && Q.spd_in_government) {
        Q.economic_expansion += Q.economic_growth/2;
    }
    /////////////////////////////// update opinions based on economy
    if (Q.unemployed > 15 && Q.pro_status_quo > 50) {
        Q.pro_status_quo -= 1;
    }
    if (Q.unemployed > 30 && Q.pro_status_quo > 35) {
        Q.pro_status_quo -= 1;
    }
    if (Q.inflation >= 8 && Q.pro_status_quo > 40) {
        Q.pro_status_quo -= 1;
    }
    if ((Q.afd_votes + Q.linke_votes + Q.bsw_votes) - (100 - Q.pro_status_quo) > 5) {
        Q.pro_status_quo -= 1;
    }
if ((Q.afd_votes + Q.linke_votes + Q.bsw_votes) - (100 - Q.pro_status_quo) > 5) {
        Q.pro_status_quo -= 1;
    }
    if ((Q.afd_votes + Q.linke_votes + Q.bsw_votes) - (100 - Q.pro_status_quo) > 10) {
        Q.pro_status_quo -= 2;
    }
if ((Q.afd_votes + Q.linke_votes + Q.bsw_votes) - (100 - Q.pro_status_quo) > 10) {
        Q.pro_status_quo -= 2;
    }
    if (Q.afd_votes >= 26 && Q.greens_votes < 10) Q.greens_relation += 1;
if (Q.afd_votes >= 26 && Q.spd_votes < 10) Q.spd_relation += 1;
if (Q.afd_votes >= 33 && Q.greens_votes < 9) Q.greens_relation += 1;
if (Q.afd_votes >= 33 && Q.spd_votes < 9) Q.spd_relation += 1;

if (Q.social_moderation < 0) {
Q.social_moderation = 0
}
if (Q.econ_moderation < 0) {
Q.econ_moderation = 0
}
if (Q.foreign_moderation < 0) {
Q.foreign_moderation = 0
}
if (Q.social_moderation > 10) {
Q.social_moderation = 10
}
if (Q.econ_moderation > 10) {
Q.econ_moderation = 10
}
if (Q.foreign_moderation > 10) {
Q.foreign_moderation = 10
}

    if (Q.bsw_split && Q.social_moderation <= 1) {
        Q.pragmatist_dissent += 0.3;
    }
if (Q.bsw_split && Q.foreign_moderation == 10) {
        Q.beweli_dissent += 0.3;
    }
    if (Q.bsw_split && Q.bsw_rising) {
        Q.east_linke -= 0.4;
        Q.east_bsw += 0.4;
    } 
if (Q.bsw_split && Q.bsw_rising == 0) {
        Q.east_linke += 0.2;
        Q.east_bsw -= 0.2;
    }
if (Q.bsw_split && Q.bsw_rising) {
        Q.rural_linke -= 0.1;
        Q.rural_bsw += 0.1;
    } 
if (Q.bsw_split && Q.bsw_rising == 0) {
        Q.rural_linke += 0.1;
        Q.rural_bsw -= 0.1;
    }

    if (Q.pro_status_quo >= 90) {
        Q.social_moderation += 0.2;
Q.foreign_moderation += 0.2;
Q.econ_moderation += 0.2;
    }


    ///////////////////////////// change party support based on pro_republic
    // if pro_republic is less than the support of the Weimar coalition, reduce SPD support...
    if (Q.pro_status_quo < (Q.spd_votes + Q.greens_votes + Q.fdp_votes + Q.cdu_votes)) {
        Q.youth_spd -= 0.3;
Q.youth_greens -= 0.3;
Q.youth_fdp -= 0.3;
Q.youth_cdu -= 0.3;
Q.youth_linke += 0.6*(1-dissent);
Q.youth_afd += 0.6;
Q.rural_spd -= 0.3;
Q.rural_greens -= 0.3;
Q.rural_fdp -= 0.3;
Q.rural_cdu -= 0.3;
Q.rural_linke += 0.2*(1-dissent);
Q.rural_afd += 1;
Q.east_spd -= 0.4;
Q.east_greens -= 0.4;
Q.east_fdp -= 0.4;
Q.east_cdu -= 0.4;
Q.east_linke += 0.8*(1-dissent);
Q.east_afd += 0.8;
Q.urban_spd -= 0.3;
Q.urban_greens -= 0.3;
Q.urban_fdp -= 0.3;
Q.urban_cdu -= 0.3;
Q.urban_linke += 0.6*(1-dissent);
Q.urban_afd += 0.6;
Q.upper_spd -= 0.3;
Q.upper_greens -= 0.3;
Q.upper_fdp -= 0.3;
Q.upper_cdu -= 0.3;
Q.upper_linke += 0.2*(1-dissent);
Q.upper_afd += 1;
if (Q.bsw_split) {
Q.urban_bsw += 0.1;
Q.rural_bsw += 0.2;
Q.east_bsw += 0.4;
Q.youth_bsw += 0.1;
}
if (Q.bsw_split && Q.bsw_rising) {
Q.urban_bsw += 0.3;
Q.rural_bsw += 0.6;
Q.east_bsw += 1.2;
Q.youth_bsw += 0.3;
Q.urban_linke -= 0.3;
Q.rural_linke -= 0.6;
Q.east_linke -= 1.2;
Q.youth_linke -= 0.3;
}
Q.pro_status_quo += 1;
    }

    Q.oldleft_dissent_decay = 1;
    Q.beweli_dissent_decay = 1;
    Q.emali_dissent_decay = 1;
    Q.pragmatist_dissent_decay = 1;

    Q.oldleft_strength_gain = 0;
    Q.beweli_strength_gain = 0;
    Q.emali_strength_gain = 0;
    Q.pragmatist_strength_gain = 0;

    if (Q.oldleft_strength < 10) Q.oldleft_dissent_decay += 1;
    if (Q.emali_strength < 10) Q.emali_dissent_decay += 1;
    if (Q.beweli_strength < 10) Q.beweli_dissent_decay += 1;
    if (Q.pragmatist_strength < 10) Q.pragmatist_dissent_decay += 1;


    if (Q.afd_votes >= 20) {
        Q.oldleft_dissent_decay *= 0.6;
        Q.beweli_dissent_decay *= 0.7;
        Q.emali_dissent_decay *= 0.8;
        Q.pragmatist_dissent_decay *= 0.5;
    }

    // SIMULATE FACTION DISSENT DECAY BASED ON ADVISORS TODO
//     SIMULATE ADVISOR PASSIVE ACTIONS
    Q.beweli_dissent += Q.beweli_dissent_decay;
    Q.emali_dissent += Q.emali_dissent_decay;
    Q.oldleft_dissent += Q.oldeft_dissent_decay;
    Q.pragmatist_dissent += Q.pragmatist_dissent_decay;

    if (Q.emali_strength < 0) Q.emali_strength = 0;
    if (Q.beweli_strength < 0) Q.beweli_strength = 0;
    if (Q.oldleft_strength < 0) Q.oldleft_strength = 0;
    if (Q.pragmatist_strength < 0) Q.pragmatist_strength = 0;

 if (Q.emali_dissent < 0) Q.emali_dissent = 0;
    if (Q.beweli_dissent < 0) Q.beweli_dissent = 0;
    if (Q.oldleft_dissent < 0) Q.oldleft_dissent = 0;
    if (Q.pragmatist_dissent < 0) Q.pragmatist_dissent = 0;

// changes faction strength

    Q.emali_strength += Q.emali_strength_gain;
    Q.beweli_strength += Q.beweli_strength_gain;
    Q.oldleft_strength += Q.oldleft_strength_gain;
    Q.pragmatist_strength += Q.pragmatist_strength_gain; 

// changes party relations based on factions

    if (Q.pragmatist_strength >= 60) {
        if (Q.greens_relation < 30) {
            Q.greens_relation += 0.5;
        }
if (Q.spd_relation < 30) {
            Q.spd_relation += 0.5;
        }
    } else if (Q.pragmatist_strength >= 60) {
        if (Q.greens_relation < 30) {
            Q.greens_relation += 0.5;
        }
if (Q.spd_relation < 30) {
            Q.spd_relation += 0.5;
        }  
    }

    if (Q.oldleft_strength >= 60 && Q.bsw_split) {
        Q.bsw_relation += 0.5;
    }


// changes afd votes based on migration + wählerpotential

if (Q.afd_votes < (Q.issue_migration*5)) {
Q.rural_afd += 0.7;
Q.east_afd += 1;
Q.upper_afd += 0.2;
Q.youth_afd += 0.3;
Q.urban_afd += 0.3;
}

// status quo votes + being in government

if (Q.pro_status_quo < 70 && Q.linke_in_goverment) {
Q.rural_linke -= 0.02*(100-pro_status_quo);
Q.urban_linke -= 0.03*(100-pro_status_quo);
Q.youth_linke -= 0.04*(100-pro_status_quo);
Q.east_linke -= 0.04*(100-pro_status_quo);
Q.upper_linke -= 0.01*(100-pro_status_quo);
}
if (Q.pro_status_quo < 70 && Q.spd_in_goverment) {
Q.rural_spd -= 0.02*(100-pro_status_quo);
Q.urban_spd -= 0.03*(100-pro_status_quo);
Q.youth_spd -= 0.04*(100-pro_status_quo);
Q.east_spd -= 0.03*(100-pro_status_quo);
Q.upper_spd -= 0.01*(100-pro_status_quo);
}
if (Q.pro_status_quo < 70 && Q.greens_in_goverment) {
Q.rural_greens -= 0.01*(100-pro_status_quo);
Q.urban_greens -= 0.02*(100-pro_status_quo);
Q.youth_greens -= 0.04*(100-pro_status_quo);
Q.east_greens -= 0.01*(100-pro_status_quo);
Q.upper_greens -= 0.03*(100-pro_status_quo);
}
if (Q.pro_status_quo < 70 && Q.fdp_in_goverment) {
Q.rural_fdp -= 0.01*(100-pro_status_quo);
Q.urban_fdp -= 0.03*(100-pro_status_quo);
Q.youth_fdp -= 0.04*(100-pro_status_quo);
Q.east_fdp -= 0.01*(100-pro_status_quo);
Q.upper_fdp -= 0.04*(100-pro_status_quo);
}
if (Q.pro_status_quo < 70 && Q.cdu_in_goverment) {
Q.rural_cdu -= 0.04*(100-pro_status_quo);
Q.urban_cdu -= 0.02*(100-pro_status_quo);
Q.youth_cdu -= 0.04*(100-pro_status_quo);
Q.east_cdu -= 0.03*(100-pro_status_quo);
Q.upper_cdu -= 0.02*(100-pro_status_quo);
}
