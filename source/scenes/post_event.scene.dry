Q.rural_bsw -= 0.03*(100-pro_status_quo);
Q.urban_bsw -= 0.01*(100-pro_status_quo);
Q.youth_bsw -= 0.03*(100-pro_status_quo);
Q.east_bsw -= 0.05*(100-pro_status_quo);
Q.upper_bsw -= 0.01*(100-pro_status_quo);
}


