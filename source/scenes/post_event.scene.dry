            Q.sa_strength += (75*(100 - Q.pro_republic) / 100) /12;
            if (Q.sa_banned && Q.sa_strength > Q.old_sa_strength) {
                Q.sa_strength -= (50*(100 - Q.pro_republic) / 100) /12;
            }
