- @root: Return to main

@environment
title: environment
subtitle: subt
choose-if: advisor_action_timer <= 0
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] months before next advisor action. ?]
on-arrival: advisor_action_timer = 6; social_moderation -= 0.2*(pantisano_advisor_fame/100); issue_environment += 0.5*(pantisano_advisor_fame/100); pantisano_advisor_fame += 2; greens_relation += 1;

@rally
title: rally
subtitle: subt
choose-if: advisor_action_timer <= 0
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] months before next advisor action. ?]
on-arrival: advisor_action_timer = 6; last_advisor_action = 1; pantisano_advisor_fame += 2;
go-to: rally

@attack_right
title: attack right
subtitle: subt
choose-if: advisor_action_timer <= 0
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] months before next advisor action. ?] 
on-arrival: advisor_action_timer = 6; youth_cdu -= 0.6*(pantisano_advisor_fame/100); youth_afd -= 0.6*(pantisano_advisor_fame/100); youth_linke += 1.2*(pantisano_advisor_fame/100); pantisano_advisor_fame += 2;
