- @moderate_economic
- @campaign_east
- @root: Return to main

@moderate_economic
title: moderate econ
subtitle: subt
choose-if: advisor_action_timer <= 0 and ramelow_advisor == 1
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] months before next advisor action. ?] 
on-arrival: advisor_action_timer = 6; econ_moderation += 0.8*(ramelow_advisor_fame/100); pragmatist_dissent -= 1*(ramelow_advisor_fame/100); spd_relation += 2*(ramelow_advisor_fame/100); cdu_relation += 1*(ramelow_advisor_fame/100); beweli_dissent += 1; issue_cost_of_living -= 0.3; ramelow_advisor_fame += 2;

@campaign_east
title: campaign_east
subtitle: subt
choose-if: advisor_action_timer <= 0
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] months before next advisor action. ?] 
on-arrival: advisor_action_timer = 6; east_linke += 2.5*(ramelow_advisor_fame/100)*(1-dissent); ramelow_advisor_fame += 2;
