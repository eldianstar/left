@foreign_party
title: radicalize
subtitle: subt
choose-if: advisor_action_timer <= 0
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] months before next advisor action. ?]
on-arrival: advisor_action_timer = 6; international_relations_timer -= 12; last_advisor_action = 1; riexinger_advisor_fame += 2;
go-to: international_relations

@campaign_workers
title: campaign_workers
subtitle: subt
choose-if: advisor_action_timer <= 0
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] months before next advisor action. ?] 
on-arrival: advisor_action_timer = 6; urban_linke += 2*(riexinger_advisor_fame/100)*(1-dissent); tradeunion_contact += 0.1; riexinger_advisor_fame += 2;

@horseshoe
title: soz.li/horseshoe
subtitle: subt
choose-if: advisor_action_timer <= 0 and riexinger_advisor == 1
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] months before next advisor action. ?]
on-arrival: advisor_action_timer = 6; wagenknecht_advisor_fame -= 2; tradeunion_contact += 0.3*(riexinger_advisor_fame/100); oldleft_dissent -= 3*(riexinger_advisor_fame/100); emali_dissent -= 3*(riexinger_advisor_fame/100); riexinger_advisor_fame += 2;
