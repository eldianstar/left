@factions

= Internal Factions

<span class="tooltip-text" title="oldleft text" style="text-align: center;font-weight: bold;color: [+ bsw_color +];">Old Left</span> <br>
<div style="display: flex;gap: 5px;margin-bottom: 5px;margin-left: -3px;">
<img src="img/LogoAufstehen.jpg" alt="Aufstehen" style="width: 48%;object-fit:contain;">
<img src="img/_portraits/WagenknechtSahra.jpg" alt="Sahra Wagenknecht" style="width: 48%;object-fit:cover;object-position:top;border:3px ridge [+ cdu_color +];">
</div>
<div style="display: flex; justify-content: space-between; gap: 0px; margin-bottom: 5px;">
