title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

[+ month : month +] [+ year +]

Resources available: [+ resources +]

<span style="color: [+ linke_color +];">**Die Linke**</span> position: [? if linke_toleration : toleration ?][? if linke_in_government : in government - ?][? if linke_toleration == 0 and linke_in_government == 0 : opposition ?]
[? if in_rrgreen_coalition and linke_in_government: <span style="color: [+ linke_color +];">Red</span><span style="color: [+ spd_color +];">red</span><span style="color: [+ greens_color +];">green</span> Coalition ?][? if in_left_front and linke_in_government: <span style="color: [+ linke_color +];">Red</span>-<span style="color: [+ bsw_color +];">purple</span> coalition ?][? if in_linke_majority and linke_in_government: <span style="color: [+ linke_color +];">**Linke**</span> majority ?]

Internal dissent: [+ dissent_percent : dissent +]

= Government

President: <span style="color: [+ spd_color +];">**[+ president +]**</span>

Chancellor: [? if chancellor_party = 'LINKE' : <span style="color: [+ linke_color +];">**[+ chancellor +]**</span> ?][? if chancellor_party = 'BSW' : <span style="color: [+ bsw_color +];">**[+ chancellor +]**</span> ?][? if chancellor_party = 'Greens' : <span style="color: [+ bsw_color +];">**[+ chancellor +]**</span> ?][? if chancellor_party = 'SPD' : <span style="color: [+ spd_color +];">**[+ chancellor +]**</span> ?][? if chancellor_party = 'FDP' : <span style="color: [+ fdp_color +];">**[+ chancellor +]**</span> ?][? if chancellor_party = 'CDU' : <span style="color: [+ cdu_color +];">**[+ chancellor +]**</span> ?][? if chancellor_party = 'CSU' : <span style="color: [+ csu_color +];">**[+ chancellor +]**</span> ?][? if chancellor_party = 'AfD' : <span style="color: [+ afd_color +];">**[+ chancellor +]**</span> ?]

Bundestag composition:

# 1928: 30, 1930: 25, 1932: 22

<span class="tooltip-text" title="The Left" style="color: [+ linke_color +];">**Linke**</span>: [+ linke_b +]% <br>
[? if bsw_split : <span class="tooltip-text" title="Sahra Wagenknecht Alliance" style="color: [+ bsw_color +];">**BSW**</span>: [+ bsw_b +]% <br> ?]
<span class="tooltip-text" title="Social Democratic Party of Germany" style="color: [+ spd_color +];">**SPD**</span>: [+ spd_b +]% <br>
<span class="tooltip-text" title="Alliance 90/The Greens" style="color: [+ greens_color +];">**B90/Greens**</span>: [+ greens_b +]% <br>
<span class="tooltip-text" title="Free Democratic Party" style="color: [+ fdp_color +];">**FDP**</span>: [+ fdp_b +]% <br>
<span class="tooltip-text" title="Christian Democratic Union/Christian Social Union" style="color: [+ cdu_color +];">**CDU/CSU**</span>: [+ cdu_b +]% <br>
<span class="tooltip-text" title="Alternative for Germany" style="color: [+ afd_color +];">**AfD**</span>: [+ afd_b +]% <br>

# 1928: 9, 1930: 10
**Others**: [+ other_b +]%

[? if linke_in_government = 1 : Budget: [+ budget +] ?]

Next election: [+ next_election_month : month +] [+ next_election_year +]

= Economics

Inflation: [+ inflation_2 +]%

Unemployment: [+ unemployed_2 +]%

Economic growth: [+ economic_growth_2 +]%

@govt

Budget: [+ budget +]

[? if linke_in_government and spd_in_government : <span style="color: [+ spd_color +];">SPD</span> coalition dissent: [+ spd_coalition_dissent : coalition_dissent +] ?]
[? if linke_in_government and greens_in_government : <span style="color: [+ greens_color +];">Green</span> coalition dissent: [+ greens_coalition_dissent : coalition_dissent +] ?]
[? if linke_in_government and bsw_in_government : <span style="color: [+ bsw_color +];">BSW</span> coalition dissent: [+ bsw_coalition_dissent : coalition_dissent +] ?]

