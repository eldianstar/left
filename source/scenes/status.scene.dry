[? if in_rrgreen_coalition and linke_in_government: <span style="color: #BC2D72;">Red</span><span style="color: #E3000F;">red</span><span style="color: #1AA037;">green</span> Coalition ?][? if in_left_front and linke_in_government: <span style="color: #BC2D72;">Socialist</span>-<span style="color: #4C0B5F;">coalitionc</span> ?][? if in_linke_majority and linke_in_government: <span style="color: #BC2D72;">**Linke**</span> majority ?]

Internal dissent: [+ dissent_percent : dissent +]

